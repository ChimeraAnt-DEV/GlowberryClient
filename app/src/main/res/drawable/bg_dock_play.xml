<?xml version="1.0" encoding="utf-8"?>
<!--
    The dock's Play button: an accent-500 to accent-400 gradient with a 14dp radius, the primary
    action of the Launch tab.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="@color/ui_accent_500"
        android:endColor="@color/ui_accent_400"
        android:angle="0" />
    <corners android:radius="@dimen/radius_large" />
</shape>
