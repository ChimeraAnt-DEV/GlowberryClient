<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ?attr/colorPrimary, not @color/primary: Material You dynamic color rewrites theme
         attributes at runtime, so a color-resource reference would stay behind the wallpaper. -->
    <solid android:color="?attr/colorPrimary" />
    <corners android:radius="@dimen/radius_chip" />
</shape>
