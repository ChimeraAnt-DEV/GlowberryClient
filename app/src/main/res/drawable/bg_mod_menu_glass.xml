<?xml version="1.0" encoding="utf-8"?>
<!--
    The Mod Menu panel's glass surface (M4).

    A hairline outline over the panel's translucent fill, matching the wheel's regular tier. The
    layout paints this over the captured backdrop; when glass is off (Reduce transparency, or the
    glass-intensity setting at Off) the panel is drawn solid instead and this layer is skipped.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/mod_menu_glass_fill" />
    <corners android:radius="@dimen/radius_xlarge" />
    <stroke
        android:width="0.5dp"
        android:color="@color/mod_menu_border_hairline" />
</shape>
