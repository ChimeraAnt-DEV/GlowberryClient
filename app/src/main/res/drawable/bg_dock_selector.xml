<?xml version="1.0" encoding="utf-8"?>
<!--
    The version / profile selector inside the launch dock: a soft translucent pill on the dark
    plate, so it reads as a secondary control next to the Play button rather than a second button.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dock_version_bg" />
    <corners android:radius="@dimen/radius_large" />
    <stroke
        android:width="1dp"
        android:color="@color/launch_dock_stroke" />
</shape>
