<?xml version="1.0" encoding="utf-8"?>
<!--
    Rounded outline for the "doesn't work or is bugged" label.
    An outline rather than a fill: a filled pill reads as a status the module has, an outline
    reads as a warning about it. The wash is kept very light so the red text stays legible on the
    dark card.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1AFF5252" />
    <stroke
        android:width="1dp"
        android:color="#99FF5252" />
    <corners android:radius="@dimen/radius_chip_small" />
</shape>
