<?xml version="1.0" encoding="utf-8"?>
<!--
    The Play button while the launcher is still preparing (assets/native bridges loading). A muted
    plate in the accent's own hue, so the control reads as "not ready yet" rather than as a broken
    gradient.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/brand_primary_33" />
    <corners android:radius="@dimen/radius_large" />
</shape>
