<?xml version="1.0" encoding="utf-8"?>
<!--
    The container behind a Launch-tab section header. A soft glass plate with a hairline border and
    a faint accent wash on the start edge, so each section reads as its own titled block rather than
    a label floating over the page. Uses brand tokens only, so it follows the wallpaper palette.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_background" />
            <corners android:radius="@dimen/radius_medium" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_border" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/brand_primary_10"
                android:endColor="@android:color/transparent"
                android:type="linear" />
            <corners android:radius="@dimen/radius_chip" />
        </shape>
    </item>
</layer-list>
