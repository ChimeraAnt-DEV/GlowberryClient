<?xml version="1.0" encoding="utf-8"?>
<!--
    The runtime-kind badge on a mod row (U17): "native" or "script". A hairline pill so it reads as
    metadata beside the failure/verified badges rather than competing with them.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_variant" />
    <corners android:radius="@dimen/radius_tag" />
    <stroke
        android:width="1dp"
        android:color="@color/card_border" />
</shape>
