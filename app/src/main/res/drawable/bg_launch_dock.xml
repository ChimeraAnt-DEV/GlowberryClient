<?xml version="1.0" encoding="utf-8"?>
<!--
    The docked launch control bar. A dark translucent plate with a 24dp radius and a hairline
    light stroke (the Material 3 "glass" treatment), so the Play controls read as one floating
    surface at the bottom of the Launch tab instead of loose buttons.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/launch_dock_bg" />
    <corners android:radius="@dimen/radius_window" />
    <stroke
        android:width="1dp"
        android:color="@color/launch_dock_stroke" />
</shape>
