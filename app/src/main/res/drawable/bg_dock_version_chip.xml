<?xml version="1.0" encoding="utf-8"?>
<!--
    The version chip in the launch dock (U15). A pill, not a button: a single-line value with a
    caret, so it reads as the current selection rather than as an action of its own.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dock_version_bg" />
    <corners android:radius="@dimen/radius_pill" />
    <stroke
        android:width="1dp"
        android:color="@color/launch_dock_stroke" />
</shape>
