<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppFullScreenTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:fontFamily">@font/misans</item>
    </style>

    <style name="AppPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu_square</item>
        <item name="android:listDivider">@drawable/divider_menu_item</item>
    </style>

    <style name="PopupAccountSwitch_Animation">
        <item name="android:windowEnterAnimation">@anim/popup_in</item>
        <item name="android:windowExitAnimation">@anim/popup_out</item>
    </style>

    <!--
        Root of the Chimera widget style namespace. The dotted names below infer their
        parents from it, so it must exist even though it carries no attributes itself.
    -->
    <style name="Widget.Chimera" parent="" />

    <!--
        One tab in the top navigation bar. A single TextView carrying its icon via
        drawableStart, so the icon tints with the label (see BaseActivity.setActiveNavTab).
        paddingHorizontal sits in a dimen where a w600dp override widens it: on a phone the
        icon-only tabs need generous padding to stay tappable, while a tablet with full labels
        wants them tighter so six entries fit without scrolling.
    -->
    <style name="Widget.Chimera.NavTab" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">@dimen/nav_tab_padding</item>
        <item name="android:fontFamily">@font/misans</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:drawablePadding">@dimen/nav_tab_drawable_padding</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!--
        One destination row in the navigation rail (U5). Same font and colours as the top bar's tab,
        but the icon leads the row horizontally so it stays aligned with the label beside it; the
        expanded rail shows that label, the icon-only rail sets the text to "" in BaseActivity.
        paddingStart is the rail width so the icon lands on the same centre line as the logo above
        it, whether or not a label follows.
    -->
    <style name="Widget.Chimera.NavRailTab" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/nav_rail_tab_height</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/nav_rail_width</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:fontFamily">@font/misans</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:drawablePadding">0dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!--
        The single card style. Every card surface uses one of these three variants so the
        radius, border and elevation cannot drift screen to screen.

        Widget.Chimera.Card.<X> is the shared base; the concrete styles differ only in the
        view they must attach to (CardView vs MaterialCardView vs a plain container).
        Use the varianted style that matches the view class, not a hand-rolled background.
    -->
    <style name="Widget.Chimera.Card" parent="">
        <item name="android:background">@drawable/chimera_card</item>
        <item name="android:elevation">@dimen/chimera_card_elevation</item>
        <item name="android:padding">@dimen/chimera_card_padding</item>
    </style>

    <style name="Widget.Chimera.Card.Compact">
        <item name="android:background">@drawable/chimera_card_small</item>
        <item name="android:padding">@dimen/chimera_card_padding_compact</item>
    </style>

    <!-- For androidx.cardview.widget.CardView callers: radius/fill/stroke live on the card. -->
    <style name="Widget.Chimera.CardView" parent="CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/chimera_card_radius</item>
        <item name="cardElevation">@dimen/chimera_card_elevation</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="android:padding">@dimen/chimera_card_padding</item>
    </style>

    <!-- For MaterialCardView callers: same token set, Material attributes. -->
    <style name="Widget.Chimera.MaterialCardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/chimera_card_radius</item>
        <item name="cardElevation">@dimen/chimera_card_elevation</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">@dimen/chimera_card_border_width</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="android:padding">@dimen/chimera_card_padding</item>
    </style>

    <!--
        The Launch tab's quick dock entries: one glass tile per destination (Mods, Cosmetics, the
        wheel). A vertical icon-over-label tile so the strip stays compact and every entry is the
        same size, with the shared press feedback applied in code.
    -->
    <style name="Widget.Glowberry.QuickDock" parent="" />

    <style name="Widget.Glowberry.QuickDock.Item" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:background">@drawable/bg_quickdock_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="Widget.Glowberry.QuickDock.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/misans</item>
        <item name="android:textColor">@color/dock_text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!--
        The five type roles (U8). A surface picks a role, never a raw sp value, so two screens
        showing the same kind of text cannot drift apart. This is the XML half of {@code UiType};
        {@code TypeRoleTest} reads this file and asserts the two agree, so a size changed in one
        place and not the other fails the build.

        The family is the one CJK-capable family the app ships. It is deliberately NOT the
        variable {@code dmsans}: no shipped font is both variable and CJK-capable, and the app
        ships Chinese, Japanese and Hindi. Pointing every surface at a Latin-only family would
        render those locales as tofu boxes, which is a worse defect than a coarse weight. A role
        therefore carries size and family, and a role that wants emphasis still sets
        {@code textStyle="bold"}; the continuous {@code wght} axis is available only through
        {@code UiType.applyWeight}, on a surface that has deliberately chosen a variable family.
    -->
    <style name="TextAppearance.Glowberry" parent="">
        <item name="android:fontFamily">@font/misans</item>
    </style>

    <!-- 22sp / 600 — a screen's own title. -->
    <style name="TextAppearance.Glowberry.Display" parent="TextAppearance.Glowberry">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 16sp / 600 — a card or section title. -->
    <style name="TextAppearance.Glowberry.Title" parent="TextAppearance.Glowberry">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 14sp / 400 — body copy and control labels. -->
    <style name="TextAppearance.Glowberry.Body" parent="TextAppearance.Glowberry">
        <item name="android:textSize">14sp</item>
    </style>

    <!-- 13sp / 500 — a row's own title. -->
    <style name="TextAppearance.Glowberry.Label" parent="TextAppearance.Glowberry">
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 11sp / 400 — captions, metadata, secondary lines. -->
    <style name="TextAppearance.Glowberry.Caption" parent="TextAppearance.Glowberry">
        <item name="android:textSize">11sp</item>
    </style>

    <!--
        The two sizes the role scale genuinely cannot express, kept as named styles rather than as
        bare literals so they stay visible and countable. Both are deliberate:

        - Wordmark: the splash lockup. It is display art, not a text role; collapsing it to the
          22sp display role would visibly shrink the app's own logo.
        - Micro: a badge or chip that sits inside a 20-24dp pill. The 11sp caption does not fit the
          pill's height, and the badge is decoration around a one- or two-word value.
    -->
    <style name="TextAppearance.Glowberry.Wordmark" parent="TextAppearance.Glowberry">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Glowberry.Micro" parent="TextAppearance.Glowberry">
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
