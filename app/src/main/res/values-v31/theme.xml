<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31-34: edge-to-edge bars are enforced, so the status-bar icon colour is always light
         and both contrast scrims are off. The splash-screen attributes replace the default
         launcher icon splash. -->
    <style name="Base.Theme.FullScreen" parent="Base.Theme.FullScreen.Common">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style name="MinecraftLoadingTheme" parent="Base.Theme.FullScreen">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowSplashScreenBackground">@color/background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>

    <style name="MainActivityTheme" parent="Base.Theme.FullScreen">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowSplashScreenBackground">@color/background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>

    <style name="LauncherRestartTheme" parent="Base.Theme.FullScreen">
        <item name="android:fontFamily">@font/misans</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowSplashScreenBackground">@color/background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
