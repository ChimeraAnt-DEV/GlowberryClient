<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_2"
    android:orientation="vertical"
    android:paddingVertical="@dimen/space_2">

    <TextView
        android:id="@+id/meta_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/misans"
        android:textColor="@color/text_secondary"
        android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

    <TextView
        android:id="@+id/meta_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:fontFamily="@font/misans"
        android:textColor="@color/on_surface"
        android:textAppearance="@style/TextAppearance.Glowberry.Label"
        android:textStyle="bold" />
</LinearLayout>
