<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:background="@color/surface"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_4">

            <ImageButton
                android:id="@+id/msft_back_button"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:padding="@dimen/space_3"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/on_surface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/misans"
                    android:text="@string/ms_login_title"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/misans"
                    android:text="@string/ms_login_header_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/msft_method_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_6">

                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:contentDescription="@null"
                        android:padding="@dimen/space_2"
                        android:src="@drawable/ic_qa_account"
                        android:tint="@color/primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:fontFamily="@font/misans"
                        android:gravity="center"
                        android:text="@string/ms_choose_login_method"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.Glowberry.Display"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:fontFamily="@font/misans"
                        android:gravity="center"
                        android:maxWidth="620dp"
                        android:text="@string/ms_choose_login_method_desc"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Body" />

                    <TextView
                        android:id="@+id/msft_method_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        style="@style/Widget.Chimera.Card.Compact"
                        android:fontFamily="@font/misans"
                        android:gravity="center"
                        android:maxWidth="720dp"
                        android:padding="@dimen/space_3"
                        android:textColor="@color/status_danger_dark"
                        android:textAppearance="@style/TextAppearance.Glowberry.Body"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_2"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="@dimen/radius_card"
                            app:cardElevation="3dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:padding="@dimen/space_4">

                                <ImageView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_code"
                                    android:tint="@color/primary" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_2"
                                    android:fontFamily="@font/misans"
                                    android:gravity="center"
                                    android:text="@string/ms_device_code_option_title"
                                    android:textColor="@color/on_surface"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_2"
                                    android:fontFamily="@font/misans"
                                    android:gravity="center"
                                    android:minHeight="44dp"
                                    android:text="@string/ms_device_code_login_desc"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Label" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/msft_device_login_button"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="54dp"
                                    android:layout_marginTop="@dimen/space_3"
                                    android:fontFamily="@font/misans"
                                    android:maxLines="1"
                                    android:text="@string/ms_device_code_login"
                                    android:textAllCaps="false"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Body"
                                    android:textStyle="bold"
                                    app:cornerRadius="10dp"
                                    app:icon="@drawable/ic_internet"
                                    app:iconGravity="textStart"
                                    app:iconTint="@android:color/white" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_1"
                            android:layout_marginEnd="@dimen/space_1"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="@dimen/radius_card"
                            app:cardElevation="3dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:padding="@dimen/space_4">

                                <ImageView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_monitor"
                                    android:tint="@color/text_secondary" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_2"
                                    android:fontFamily="@font/misans"
                                    android:gravity="center"
                                    android:text="@string/ms_webview_option_title"
                                    android:textColor="@color/on_surface"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_2"
                                    android:fontFamily="@font/misans"
                                    android:gravity="center"
                                    android:minHeight="44dp"
                                    android:text="@string/ms_webview_login_desc"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Label" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/msft_web_login_button"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="54dp"
                                    android:layout_marginTop="@dimen/space_3"
                                    android:fontFamily="@font/misans"
                                    android:maxLines="1"
                                    android:text="@string/ms_webview_login"
                                    android:textAllCaps="false"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Body"
                                    android:textStyle="bold"
                                    app:cornerRadius="10dp"
                                    app:icon="@drawable/ic_monitor"
                                    app:iconGravity="textStart" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_2"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="@dimen/radius_card"
                            app:cardElevation="3dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:padding="@dimen/space_4">

                                <ImageView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_qa_account"
                                    android:tint="@color/primary" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_2"
                                    android:fontFamily="@font/misans"
                                    android:gravity="center"
                                    android:text="@string/ms_oauth_option_title"
                                    android:textColor="@color/on_surface"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_2"
                                    android:fontFamily="@font/misans"
                                    android:gravity="center"
                                    android:minHeight="44dp"
                                    android:text="@string/ms_oauth_desc"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Label" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/msft_msal_login_button"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="54dp"
                                    android:layout_marginTop="@dimen/space_3"
                                    android:fontFamily="@font/misans"
                                    android:maxLines="1"
                                    android:text="@string/ms_oauth_button_signin"
                                    android:textAllCaps="false"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Body"
                                    android:textStyle="bold"
                                    app:cornerRadius="10dp"
                                    app:icon="@drawable/ic_qa_account"
                                    app:iconGravity="textStart" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <ScrollView
                android:id="@+id/msft_device_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_6"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_3"
                        android:layout_weight="1.12"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/misans"
                            android:text="@string/ms_device_code_title"
                            android:textColor="@color/on_surface"
                            android:textAppearance="@style/TextAppearance.Glowberry.Display"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:fontFamily="@font/misans"
                            android:text="@string/ms_device_code_instructions"
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.Glowberry.Body" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="@dimen/radius_card"
                            app:cardElevation="3dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:padding="@dimen/space_4">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/misans"
                                    android:text="@string/ms_device_code_label"
                                    android:textAllCaps="true"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/msft_device_code"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_2"
                                    android:autoSizeMaxTextSize="32sp"
                                    android:autoSizeMinTextSize="20sp"
                                    android:autoSizeStepGranularity="1sp"
                                    android:autoSizeTextType="uniform"
                                    android:fontFamily="monospace"
                                    android:gravity="center"
                                    android:letterSpacing="0.14"
                                    android:maxLines="1"
                                    android:minHeight="48dp"
                                    android:text="@string/ms_device_code_waiting_code"
                                    android:textColor="@color/on_surface"
                                    android:textIsSelectable="true"
                                    android:textStyle="bold" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_marginTop="@dimen/space_3"
                                    android:background="@color/wash_grey_13" />

                                <TextView
                                    android:id="@+id/msft_device_url"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_3"
                                    android:fontFamily="@font/misans"
                                    android:gravity="center"
                                    android:text="@string/ms_device_code_requesting"
                                    android:textColor="@color/primary"
                                    android:textIsSelectable="true"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Body"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/msft_device_expiry"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_2"
                                    android:background="@drawable/bg_filter_chip"
                                    android:fontFamily="@font/misans"
                                    android:paddingHorizontal="@dimen/space_3"
                                    android:paddingVertical="@dimen/space_1"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:layout_weight="0.88"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/surface"
                            app:cardCornerRadius="@dimen/radius_card"
                            app:cardElevation="3dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/space_4">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/misans"
                                    android:text="@string/ms_device_code_step_title"
                                    android:textColor="@color/on_surface"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_1"
                                    android:fontFamily="@font/misans"
                                    android:text="@string/ms_device_code_browser_note"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Label" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/msft_open_browser"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="56dp"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:autoSizeMaxTextSize="15sp"
                                    android:autoSizeMinTextSize="11sp"
                                    android:autoSizeStepGranularity="1sp"
                                    android:autoSizeTextType="uniform"
                                    android:enabled="false"
                                    android:fontFamily="@font/misans"
                                    android:maxLines="1"
                                    android:text="@string/ms_device_code_open_browser"
                                    android:textAllCaps="false"
                                    android:textStyle="bold"
                                    app:cornerRadius="10dp"
                                    app:icon="@drawable/ic_internet"
                                    app:iconGravity="textStart"
                                    app:iconTint="@android:color/white" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/msft_copy_code"
                                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="52dp"
                                    android:layout_marginTop="@dimen/space_3"
                                    android:enabled="false"
                                    android:fontFamily="@font/misans"
                                    android:maxLines="1"
                                    android:text="@string/ms_device_code_copy"
                                    android:textAllCaps="false"
                                    android:textStyle="bold"
                                    app:cornerRadius="10dp"
                                    app:icon="@drawable/ic_code"
                                    app:iconGravity="textStart" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_4"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ProgressBar
                                        android:id="@+id/msft_device_progress"
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:indeterminate="true" />

                                    <TextView
                                        android:id="@+id/msft_device_status"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/space_3"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/misans"
                                        android:text="@string/ms_device_code_requesting"
                                        android:textColor="@color/text_secondary"
                                        android:textAppearance="@style/TextAppearance.Glowberry.Label" />
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/msft_device_cancel"
                                    style="@style/Widget.MaterialComponents.Button.TextButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="48dp"
                                    android:layout_marginTop="@dimen/space_2"
                                    android:fontFamily="@font/misans"
                                    android:text="@string/ms_choose_other_method"
                                    android:textAllCaps="false" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <FrameLayout
                android:id="@+id/msft_web_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <WebView
                    android:id="@+id/msft_login_webview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/msft_web_cancel"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="@dimen/space_4"
                    android:fontFamily="@font/misans"
                    android:text="@string/ms_choose_other_method"
                    android:textAllCaps="false"
                    app:cornerRadius="10dp" />
            </FrameLayout>

            <!-- MSAL OAuth Panel -->
            <ScrollView
                android:id="@+id/msft_msal_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_6">

                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:contentDescription="@null"
                        android:padding="@dimen/space_2"
                        android:src="@drawable/ic_qa_account"
                        android:tint="@color/primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:fontFamily="@font/misans"
                        android:gravity="center"
                        android:text="@string/ms_oauth_option_title"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.Glowberry.Display"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:fontFamily="@font/misans"
                        android:gravity="center"
                        android:maxWidth="620dp"
                        android:text="@string/ms_oauth_desc"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Body" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="@dimen/radius_card"
                        app:cardElevation="3dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_4">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/misans"
                                android:text="@string/ms_login_card_title"
                                android:textColor="@color/on_surface"
                                android:textAppearance="@style/TextAppearance.Glowberry.Title"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:fontFamily="@font/misans"
                                android:text="@string/ms_login_card_subtitle"
                                android:textColor="@color/text_secondary"
                                android:textAppearance="@style/TextAppearance.Glowberry.Label" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/msft_msal_signin"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="56dp"
                                android:layout_marginTop="@dimen/space_4"
                                android:autoSizeMaxTextSize="15sp"
                                android:autoSizeMinTextSize="11sp"
                                android:autoSizeStepGranularity="1sp"
                                android:autoSizeTextType="uniform"
                                android:fontFamily="@font/misans"
                                android:maxLines="1"
                                android:text="@string/ms_oauth_button_signin"
                                android:textAllCaps="false"
                                android:textStyle="bold"
                                app:cornerRadius="10dp"
                                app:icon="@drawable/ic_qa_account"
                                app:iconGravity="textStart"
                                app:iconTint="@android:color/white" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_4"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ProgressBar
                                    android:id="@+id/msft_msal_progress"
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:indeterminate="true"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/msft_msal_status"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_3"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/misans"
                                    android:text="@string/ms_oauth_initializing"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Label" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/msft_msal_cancel"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:layout_marginTop="@dimen/space_2"
                                android:fontFamily="@font/misans"
                                android:text="@string/ms_oauth_button_cancel"
                                android:textAllCaps="false" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:fontFamily="@font/misans"
                        android:gravity="center"
                        android:maxWidth="620dp"
                        android:text="@string/ms_login_azure_note"
                        android:textColor="@color/status_warning"
                        android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/msft_progress_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/wash_black_85"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_6">

                <ProgressBar
                    android:id="@+id/msft_progress_bar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/msft_progress_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:fontFamily="@font/misans"
                    android:gravity="center"
                    android:text="@string/ms_login_exchanging"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</FrameLayout>
