<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_6"
            android:paddingEnd="@dimen/space_6"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/instance_settings_title"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/primary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Display"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/instance_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Label" />
                </LinearLayout>

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tab_general"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="32dp"
                        android:paddingHorizontal="@dimen/space_4"
                        android:gravity="center"
                        android:text="@string/instance_tab_general"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_primary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Label"
                        android:textStyle="bold"
                        android:background="@drawable/bg_tab_selected"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tab_launch_options"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="32dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:paddingHorizontal="@dimen/space_4"
                        android:gravity="center"
                        android:text="@string/instance_tab_launch_options"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Label"
                        android:background="@drawable/bg_tab_unselected"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tab_management"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="32dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:paddingHorizontal="@dimen/space_4"
                        android:gravity="center"
                        android:text="@string/instance_tab_management"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Label"
                        android:background="@drawable/bg_tab_unselected"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </HorizontalScrollView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6">

                <LinearLayout
                    android:id="@+id/section_general"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Chimera.Card.Compact"
                        android:orientation="vertical"
                        android:padding="@dimen/space_4">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/instance_new_name"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/on_surface"
                            android:textAppearance="@style/TextAppearance.Glowberry.Title"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edit_instance_name"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="@dimen/space_3"
                            android:paddingHorizontal="@dimen/space_4"
                            android:background="@drawable/bg_search_field_light"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/on_surface"
                            android:textColorHint="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.Glowberry.Body"
                            android:singleLine="true"
                            android:importantForAutofill="no" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text="@string/instance_rename_hint"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/section_launch_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Chimera.Card.Compact"
                        android:orientation="vertical"
                        android:padding="@dimen/space_4">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/version_isolation"
                                    android:fontFamily="@font/misans"
                                    android:textColor="@color/on_surface"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_hairline"
                                    android:text="@string/instance_isolation_desc"
                                    android:fontFamily="@font/misans"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_version_isolation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:thumbTint="@color/primary"
                                android:trackTint="#555555" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/launch_vertically"
                                    android:fontFamily="@font/misans"
                                    android:textColor="@color/on_surface"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_hairline"
                                    android:text="@string/launch_vertically_desc"
                                    android:fontFamily="@font/misans"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_launch_vertically"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:thumbTint="@color/primary"
                                android:trackTint="#555555" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/shader_compat_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Shader compatibility fixer"
                                    android:fontFamily="@font/misans"
                                    android:textColor="@color/on_surface"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_hairline"
                                    android:text="Fixes shader/materialbin compatibility for resource packs"
                                    android:fontFamily="@font/misans"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_shader_compat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:thumbTint="@color/primary"
                                android:trackTint="#555555" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/in_game_pack_changer_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/in_game_pack_changer_title"
                                    android:fontFamily="@font/misans"
                                    android:textColor="@color/on_surface"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_hairline"
                                    android:text="@string/in_game_pack_changer_desc"
                                    android:fontFamily="@font/misans"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
                            </LinearLayout>

                            <com.google.android.material.switchmaterial.SwitchMaterial
                                android:id="@+id/switch_in_game_pack_changer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:thumbTint="@color/primary"
                                android:trackTint="#555555" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/bound_account_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/instance_account_title"
                                    android:fontFamily="@font/misans"
                                    android:textColor="@color/on_surface"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/bound_account_value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_hairline"
                                    android:text="@string/instance_account_active"
                                    android:fontFamily="@font/misans"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

                                <TextView
                                    android:id="@+id/bound_account_warning"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_hairline"
                                    android:text="@string/instance_account_stale"
                                    android:fontFamily="@font/misans"
                                    android:textColor="@color/mod_menu_state_warn"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <Button
                                android:id="@+id/button_bound_account"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="40dp"
                                android:minWidth="0dp"
                                android:backgroundTint="@color/secondary"
                                android:text="@string/instance_account_change"
                                android:textColor="@color/on_secondary"
                                android:paddingHorizontal="@dimen/space_4"
                                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                                android:textStyle="bold"
                                android:textAllCaps="false"
                                android:gravity="center"
                                android:fontFamily="@font/misans" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/space_4"
                            android:layout_marginBottom="@dimen/space_4"
                            android:background="@color/divider"
                            android:alpha="0.3" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/instance_shortcut_title"
                                    android:fontFamily="@font/misans"
                                    android:textColor="@color/on_surface"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_hairline"
                                    android:text="@string/instance_shortcut_desc"
                                    android:fontFamily="@font/misans"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/shortcut_config"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/instance_shortcut_name"
                                android:fontFamily="@font/misans"
                                android:textColor="@color/on_surface"
                                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/edit_shortcut_name"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="@dimen/space_2"
                                android:background="@drawable/bg_search_field_light"
                                android:fontFamily="@font/misans"
                                android:importantForAutofill="no"
                                android:paddingHorizontal="@dimen/space_4"
                                android:singleLine="true"
                                android:textColor="@color/on_surface"
                                android:textColorHint="@color/text_secondary"
                                android:textAppearance="@style/TextAppearance.Glowberry.Body" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:text="@string/instance_shortcut_icon"
                                android:fontFamily="@font/misans"
                                android:textColor="@color/on_surface"
                                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/shortcut_icon_preview"
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:contentDescription="@string/instance_shortcut_icon"
                                    android:scaleType="centerCrop"
                                    android:src="@mipmap/ic_launcher" />

                                <Button
                                    android:id="@+id/btn_choose_shortcut_icon"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minHeight="36dp"
                                    android:layout_marginStart="@dimen/space_3"
                                    android:backgroundTint="@color/primary"
                                    android:fontFamily="@font/misans"
                                    android:paddingHorizontal="@dimen/space_4"
                                    android:text="@string/instance_shortcut_choose_icon"
                                    android:textAllCaps="false"
                                    android:textColor="@color/on_primary"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

                                <Button
                                    android:id="@+id/btn_reset_shortcut_icon"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minHeight="36dp"
                                    android:layout_marginStart="@dimen/space_2"
                                    android:fontFamily="@font/misans"
                                    android:paddingHorizontal="@dimen/space_4"
                                    android:text="@string/instance_shortcut_default_icon"
                                    android:textAllCaps="false"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
                            </LinearLayout>

                            <Button
                                android:id="@+id/btn_add_instance_shortcut"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="40dp"
                                android:layout_marginTop="@dimen/space_4"
                                android:backgroundTint="@color/primary"
                                android:fontFamily="@font/misans"
                                android:paddingHorizontal="@dimen/space_6"
                                android:text="@string/instance_shortcut_add_button"
                                android:textAllCaps="false"
                                android:textColor="@color/on_primary"
                                android:textAppearance="@style/TextAppearance.Glowberry.Label" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/section_management"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/Widget.Chimera.Card.Compact"
                        android:orientation="vertical"
                        android:padding="@dimen/space_4">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/instance_backup_title"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/on_surface"
                            android:textAppearance="@style/TextAppearance.Glowberry.Title"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_hairline"
                            android:text="@string/instance_backup_desc"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

                        <Button
                            android:id="@+id/btn_backup_instance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="36dp"
                            android:layout_marginTop="@dimen/space_4"
                            android:paddingHorizontal="@dimen/space_6"
                            android:text="@string/instance_backup_button"
                            android:fontFamily="@font/misans"
                            android:textAppearance="@style/TextAppearance.Glowberry.Label"
                            android:textColor="@color/on_primary"
                            android:backgroundTint="@color/primary"
                            android:textAllCaps="false" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        style="@style/Widget.Chimera.Card.Compact"
                        android:orientation="vertical"
                        android:padding="@dimen/space_4">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/instance_danger_zone"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/on_surface"
                            android:textAppearance="@style/TextAppearance.Glowberry.Title"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_hairline"
                            android:text="@string/instance_danger_zone_desc"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/space_4"
                            android:layout_marginBottom="@dimen/space_4"
                            android:background="@color/divider"
                            android:alpha="0.3" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/delete"
                                    android:fontFamily="@font/misans"
                                    android:textColor="@color/on_surface"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_hairline"
                                    android:text="@string/instance_delete_desc"
                                    android:fontFamily="@font/misans"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_hairline"
                                    android:text="@string/instance_delete_warning"
                                    android:fontFamily="@font/misans"
                                    android:textColor="#E53935"
                                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
                            </LinearLayout>

                            <Button
                                android:id="@+id/btn_delete_instance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="36dp"
                                android:paddingHorizontal="@dimen/space_6"
                                android:text="@string/delete"
                                android:fontFamily="@font/misans"
                                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#E53935"
                                android:textAllCaps="false" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </FrameLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
