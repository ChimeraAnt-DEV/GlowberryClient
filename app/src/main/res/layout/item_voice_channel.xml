<?xml version="1.0" encoding="utf-8"?>
<!-- One channel in the live directory: name, member count, and a tap to join. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_3"
    android:paddingVertical="@dimen/space_2"
    android:background="@drawable/chimera_card_small"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/voice_channel_row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/misans"
        android:textColor="@color/on_surface"
        android:textAppearance="@style/TextAppearance.Glowberry.Body" />

    <TextView
        android:id="@+id/voice_channel_row_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_2"
        android:fontFamily="@font/misans"
        android:textColor="@color/text_secondary"
        android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

</LinearLayout>
