<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_1"
    style="@style/Widget.Chimera.Card"
    android:orientation="vertical"
    android:padding="@dimen/space_2">

    <ImageView
        android:id="@+id/screenshot_image"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:background="#1E1E1E" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/screenshot_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misans"
                android:text="@string/screenshot_name_placeholder"
                android:textColor="@color/on_surface"
                android:textAppearance="@style/TextAppearance.Glowberry.Body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/screenshot_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_hairline"
                android:fontFamily="@font/misans"
                android:text="@string/screenshot_date_placeholder"
                android:textColor="@color/on_surface"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/screenshot_save_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_2"
                android:backgroundTint="@color/primary"
                android:fontFamily="@font/misans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="@dimen/space_4"
                android:paddingVertical="@dimen/space_2"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="@color/on_primary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

            <Button
                android:id="@+id/screenshot_delete_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/error"
                android:fontFamily="@font/misans"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="@dimen/space_4"
                android:paddingVertical="@dimen/space_2"
                android:text="@string/delete"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
