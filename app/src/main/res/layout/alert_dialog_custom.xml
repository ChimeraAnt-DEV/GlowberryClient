<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="@dimen/space_6"
    style="@style/Widget.Chimera.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxHeight="500dp">

    <TextView
        android:id="@+id/tv_title"
        android:textAppearance="@style/TextAppearance.Glowberry.Title"
        android:textStyle="bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ScrollView
        android:id="@+id/message_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/space_3"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tv_message"
            android:textAppearance="@style/TextAppearance.Glowberry.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp" />
    </ScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/items_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/space_3"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/custom_view_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:orientation="vertical"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/btn_container"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:gravity="end">

        <Button
            android:id="@+id/btn_negative"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textAppearance="@style/TextAppearance.Glowberry.Body"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingStart="@dimen/space_3"
            android:paddingEnd="@dimen/space_3" />

        <View
            android:id="@+id/btn_spacing_neg_neu"
            android:layout_width="8dp"
            android:layout_height="0dp" />

        <Button
            android:id="@+id/btn_neutral"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textAppearance="@style/TextAppearance.Glowberry.Body"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingStart="@dimen/space_3"
            android:paddingEnd="@dimen/space_3"
            android:visibility="gone" />

        <View
            android:id="@+id/btn_spacing_neu_pos"
            android:layout_width="8dp"
            android:layout_height="0dp" />

        <Button
            android:id="@+id/btn_positive"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:textAppearance="@style/TextAppearance.Glowberry.Body"
            android:ellipsize="end"
            android:maxLines="1"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary"
            android:paddingStart="@dimen/space_3"
            android:paddingEnd="@dimen/space_3" />
    </LinearLayout>
</LinearLayout>
