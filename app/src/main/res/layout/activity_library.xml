<?xml version="1.0" encoding="utf-8"?>
<!--
    The Library destination (U1/U3).

    One of the four top-level screens. It hosts the three library surfaces — Instances, Install
    (the package-source version list) and Replay — behind an inner segmented control, exactly the
    way Customize hosts Controller/Skins. The screens themselves are fragments
    (InstancesFragment / InstallationsFragment / ReplayFragment) so the host stays a thin switcher
    and each surface keeps its own state and lifecycle.

    A horizontal scroller holds the tabs so a compact window (or a large font scale) can still
    reach every one of them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/library_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="15dp">

        <TextView
            android:id="@+id/library_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_library"
            android:fontFamily="@font/misans"
            android:textColor="@color/primary"
            android:textAppearance="@style/TextAppearance.Glowberry.Display"
            android:textStyle="bold" />

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/library_tab_instances"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:paddingHorizontal="18dp"
                android:gravity="center"
                android:fontFamily="@font/misans"
                android:text="@string/nav_instances"
                android:textColor="@color/on_primary"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:textStyle="bold"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/library_tab_install"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="18dp"
                android:gravity="center"
                android:fontFamily="@font/misans"
                android:text="@string/nav_installations"
                android:textColor="@color/on_surface"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/library_tab_replay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="18dp"
                android:gravity="center"
                android:fontFamily="@font/misans"
                android:text="@string/launch_toggle_replay"
                android:textColor="@color/on_surface"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/library_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
