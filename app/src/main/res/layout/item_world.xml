<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    style="@style/Widget.Chimera.Card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/world_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/misans"
            android:text="@string/world_name_placeholder"
            android:textColor="@color/on_surface"
            android:textAppearance="@style/TextAppearance.Glowberry.Title"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/world_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/misans"
        android:text="@string/world_game_mode_survival_placeholder"
        android:textColor="@color/on_surface"
        android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/world_size"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/misans"
            android:text="@string/world_size_placeholder"
            android:textColor="@color/on_surface"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

        <TextView
            android:id="@+id/world_last_played"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misans"
            android:text="@string/world_last_played_placeholder"
            android:textColor="@color/on_surface"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/world_edit_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/primary"
            android:fontFamily="@font/misans"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="@string/edit"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

        <Button
            android:id="@+id/world_extract_structures_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/tertiary"
            android:fontFamily="@font/misans"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="@string/extract_structures"
            android:textAllCaps="false"
            android:textColor="@color/on_tertiary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

        <Button
            android:id="@+id/world_transfer_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/secondary"
            android:fontFamily="@font/misans"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="@string/transfer"
            android:textAllCaps="false"
            android:textColor="@color/on_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/world_export_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/primary"
            android:fontFamily="@font/misans"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="@string/export"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

        <Button
            android:id="@+id/world_backup_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/primary"
            android:fontFamily="@font/misans"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="@string/backup"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

        <Button
            android:id="@+id/world_delete_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/error"
            android:fontFamily="@font/misans"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="@string/delete"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
    </LinearLayout>
</LinearLayout>
