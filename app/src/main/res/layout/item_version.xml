<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_1"
    android:layout_marginStart="0dp"
    android:layout_marginEnd="@dimen/space_3">

    <LinearLayout
        android:id="@+id/linear_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_align_inset"
        style="@style/Widget.Chimera.Card.Compact"
        android:paddingStart="@dimen/space_3"
        android:paddingEnd="@dimen/space_2"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_2"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:foreground="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tv_version_name_item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.Glowberry.Title"
            android:textColor="@color/on_surface"
            android:fontFamily="@font/misans"/>

        <ImageButton
            android:id="@+id/btn_rename"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_edit"
            android:tint="@color/primary"
            android:padding="@dimen/space_2"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@string/rename"
            />
    </LinearLayout>
</FrameLayout>