<?xml version="1.0" encoding="utf-8"?>
<!--
    Quick-toggle cards on the Launch tab: AntEgg Mod Packs, Voice Chat and Replays. Each is a glass
    card with an icon, a label and a live status line; the card is the tap target and the status is
    bound from the feature's own state (mod count, voice route, clip count) so the Launch tab shows
    the launcher's real state rather than a static label.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- AntEgg Mod Packs -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/launch_toggle_antegg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/glass_panel_bg"
        app:cardCornerRadius="@dimen/radius_card"
        app:strokeColor="@color/glass_panel_stroke"
        app:strokeWidth="1dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_4">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_plugin"
                app:tint="@color/accent_violet" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:fontFamily="@font/misans"
                android:text="@string/launch_toggle_antegg"
                android:textColor="@color/dock_text_primary"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/launch_antegg_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_hairline"
                android:fontFamily="@font/misans"
                android:textColor="@color/dock_text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Voice Chat -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/launch_toggle_voice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_3"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/glass_panel_bg"
        app:cardCornerRadius="@dimen/radius_card"
        app:strokeColor="@color/glass_panel_stroke"
        app:strokeWidth="1dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_4">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_nav_voice"
                app:tint="@color/accent_sky" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:fontFamily="@font/misans"
                android:text="@string/launch_toggle_voice"
                android:textColor="@color/dock_text_primary"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/launch_voice_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_hairline"
                android:fontFamily="@font/misans"
                android:textColor="@color/dock_text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Replays -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/launch_toggle_replay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_3"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="@color/glass_panel_bg"
        app:cardCornerRadius="@dimen/radius_card"
        app:strokeColor="@color/glass_panel_stroke"
        app:strokeWidth="1dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_4">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_replay"
                app:tint="@color/secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:fontFamily="@font/misans"
                android:text="@string/launch_toggle_replay"
                android:textColor="@color/dock_text_primary"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/launch_replay_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_hairline"
                android:fontFamily="@font/misans"
                android:textColor="@color/dock_text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
