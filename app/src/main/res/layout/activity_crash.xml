<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_6"
    android:paddingTop="@dimen/space_4"
    android:paddingEnd="@dimen/space_6"
    android:paddingBottom="@dimen/space_6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/crash_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misans"
                android:text="@string/crash_title"
                android:textColor="@color/primary"
                android:textAppearance="@style/TextAppearance.Glowberry.Display"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:layout_marginTop="@dimen/space_4"
        android:layout_weight="1"
        style="@style/Widget.Chimera.Card.Compact"
        android:orientation="vertical"
        android:padding="@dimen/space_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_logs"
                app:tint="@color/primary" 
                android:importantForAccessibility="no"
                />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_weight="1"
                android:fontFamily="@font/misans"
                android:text="@string/crash_details_title"
                android:textColor="@color/on_surface"
                android:textAppearance="@style/TextAppearance.Glowberry.Title"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_3"
            android:layout_marginBottom="@dimen/space_3"
            android:alpha="0.3"
            android:background="@color/divider" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_spinner_outline"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:padding="@dimen/space_3"
            android:scrollbarStyle="insideInset">

            <TextView
                android:id="@+id/crash_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/on_surface"
                android:textIsSelectable="true"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_back_to_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/surface_variant"
                android:fontFamily="@font/misans"
                android:minWidth="0dp"
                android:minHeight="40dp"
                android:paddingHorizontal="@dimen/space_6"
                android:text="@string/crash_back_to_main"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_share_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3"
                android:backgroundTint="@color/primary"
                android:fontFamily="@font/misans"
                android:minWidth="0dp"
                android:minHeight="40dp"
                android:paddingHorizontal="@dimen/space_6"
                android:text="@string/crash_share_log"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:textStyle="bold"
                app:icon="@drawable/ic_upload"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
