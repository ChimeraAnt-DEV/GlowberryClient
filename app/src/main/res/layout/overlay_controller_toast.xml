<?xml version="1.0" encoding="utf-8"?>
<!--
    A glass pill that slides down from the top for the controller connected/disconnected message.
    A plain rounded panel: the icon, two text lines, a profile chip and a small glow, all tinted
    at runtime from the user's accent.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/controller_toast_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="16dp"
    android:paddingVertical="10dp"
    android:background="@drawable/bg_controller_toast">

    <ImageView
        android:id="@+id/controller_toast_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="@string/controller_title"
        android:src="@drawable/ic_nav_controller"
        app:tint="@color/accent_text" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/controller_toast_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misans"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/on_surface"
            android:textAppearance="@style/TextAppearance.Glowberry.Label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/controller_toast_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/misans"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="@string/controller_detected_message"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

    </LinearLayout>

    <TextView
        android:id="@+id/controller_toast_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_controller_toast_chip"
        android:fontFamily="@font/misans"
        android:paddingHorizontal="9dp"
        android:paddingVertical="3dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/on_primary"
        android:textAppearance="@style/TextAppearance.Glowberry.Caption"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
