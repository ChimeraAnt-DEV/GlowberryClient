<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background_black_border"
    android:orientation="vertical"
    android:minWidth="360dp"
    android:padding="@dimen/space_6">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/version_name"
        android:textColor="?attr/colorPrimary"
        android:textAppearance="@style/TextAppearance.Glowberry.Title"
        android:textStyle="bold"
        android:fontFamily="@font/misans"/>

    <EditText
        android:id="@+id/edit_version_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:padding="@dimen/space_3"
        android:textColor="?attr/colorOnSurface"
        android:textAppearance="@style/TextAppearance.Glowberry.Title"
        android:singleLine="true"
        android:inputType="text"
        android:background="@drawable/bg_edit_text"
        android:hint="@string/version_name"
        android:textColorHint="?attr/colorOnSurfaceVariant"/>

    <TextView
        android:id="@+id/text_version_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/name_invalid"
        android:textColor="@color/status_danger_soft"
        android:textAppearance="@style/TextAppearance.Glowberry.Caption"
        android:visibility="gone"
        android:layout_marginTop="@dimen/space_1" />

    <TextView
        android:id="@+id/text_isolation_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/import_isolation_note"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textAppearance="@style/TextAppearance.Glowberry.Caption"
        android:layout_marginTop="@dimen/space_3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="@dimen/space_6">

        <Button
            android:id="@+id/btn_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <Button
            android:id="@+id/btn_install"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/install"
            android:enabled="false"
            android:layout_marginStart="@dimen/space_3"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="?attr/colorOnPrimary" />
    </LinearLayout>

</LinearLayout>
