<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash screen: a horizontal logo + wordmark lockup centred as one group, over the ore-and-pickaxe
  loader in the bottom-right. The orbit ring/dot are gone; the loader is the progress indicator
  now, so two competing spinners would say the same thing twice.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".launcher.ui.activities.SplashActivity">

    <!-- Live backdrop: deep gradient, drifting accent glows and rising embers. It paints the
         whole background itself, so the root above is only a fallback for the first frame. -->
    <org.chimeramc.client.launcher.ui.splash.SplashSceneView
        android:id="@+id/splash_scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/splash_lockup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center">

            <View
                android:id="@+id/logoGlow"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:background="@drawable/bg_logo_glow" />

            <ImageView
                android:id="@+id/imgLeaf"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:contentDescription="@string/splash_logo_desc"
                android:src="@drawable/ic_glowberry_logo" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/splash_wordmark_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:text="@string/app_name"
                android:textColor="@color/on_background"
                android:textAppearance="@style/TextAppearance.Glowberry.Wordmark"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPreparing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:alpha="0.7"
                android:letterSpacing="0.08"
                android:text="@string/preparing_to_launch"
                android:textColor="@color/on_background"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
        </LinearLayout>
    </LinearLayout>

    <org.chimeramc.client.launcher.ui.splash.OreBlockLoaderView
        android:id="@+id/oreLoader"
        android:layout_width="148dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_6" />

    <!-- Above the lockup so shatter debris is never clipped; not clickable so it never eats taps. -->
    <FrameLayout
        android:id="@+id/splash_shatter_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
