<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_4">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/misans"
        android:text="@string/custom_flat_world"
        android:textColor="@color/primary"
        android:textAppearance="@style/TextAppearance.Glowberry.Display"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_3"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Chimera.Card.Compact"
                android:orientation="vertical"
                android:padding="@dimen/space_3">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/misans"
                    android:text="@string/world_name"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Body" />

                <EditText
                    android:id="@+id/world_name_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:background="@drawable/bg_edit_text"
                    android:fontFamily="@font/misans"
                    android:hint="@string/enter_world_name"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="@dimen/space_3"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/outline"
                    android:textAppearance="@style/TextAppearance.Glowberry.Body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:fontFamily="@font/misans"
                    android:text="@string/biome"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Body" />

                <Spinner
                    android:id="@+id/biome_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:background="@drawable/bg_edit_text"
                    android:padding="@dimen/space_2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:fontFamily="@font/misans"
                    android:text="@string/game_mode"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Body" />

                <Spinner
                    android:id="@+id/game_mode_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:background="@drawable/bg_edit_text"
                    android:padding="@dimen/space_2" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                style="@style/Widget.Chimera.Card.Compact"
                android:orientation="vertical"
                android:padding="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/misans"
                        android:text="@string/layers"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.Glowberry.Body"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/add_layer_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/primary"
                        android:fontFamily="@font/misans"
                        android:minHeight="0dp"
                        android:paddingHorizontal="@dimen/space_4"
                        android:paddingVertical="@dimen/space_2"
                        android:text="@string/add_layer"
                        android:textColor="@color/on_primary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:fontFamily="@font/misans"
                    android:text="@string/layers_hint"
                    android:textColor="@color/outline"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/layers_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3">

        <Button
            android:id="@+id/create_world_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/primary"
            android:fontFamily="@font/misans"
            android:text="@string/create_world"
            android:textColor="@color/on_primary"
            android:textAppearance="@style/TextAppearance.Glowberry.Body" />

        <ProgressBar
            android:id="@+id/loading_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>

    </LinearLayout>
</FrameLayout>
