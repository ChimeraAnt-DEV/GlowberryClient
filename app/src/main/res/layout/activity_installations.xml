<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_4"
        android:paddingTop="@dimen/space_4"
        android:paddingBottom="@dimen/space_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/misans"
                android:text="@string/installations_title"
                android:textColor="@color/on_surface"
                android:textAppearance="@style/TextAppearance.Glowberry.Display"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/installations_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:paddingHorizontal="@dimen/space_4"
                android:gravity="center"
                android:fontFamily="@font/misans"
                android:text="@string/installations_refresh"
                android:textColor="?attr/colorOnPrimary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:textStyle="bold"
                android:background="@drawable/button_accent"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/installations_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_hairline"
            android:fontFamily="@font/misans"
            android:text="@string/installations_subtitle"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

        <!-- Says plainly where packages come from; the site is a third-party mirror. -->
        <TextView
            android:id="@+id/installations_source_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:fontFamily="@font/misans"
            tools:text="Packages are downloaded from mcpedl.org, a third-party mirror."
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
            android:background="@drawable/bg_alpha_chip"
            android:paddingHorizontal="@dimen/space_3"
            android:paddingVertical="@dimen/space_2" />

        <LinearLayout
            android:id="@+id/installations_staged_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/installations_staged_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misans"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/installations_staged_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:paddingHorizontal="@dimen/space_4"
                    android:gravity="center"
                    android:fontFamily="@font/misans"
                    android:text="@string/installations_retry_import"
                    android:textColor="?attr/colorOnPrimary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    android:textStyle="bold"
                    android:background="@drawable/button_accent"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/installations_staged_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:layout_marginStart="@dimen/space_2"
                    android:paddingHorizontal="@dimen/space_4"
                    android:gravity="center"
                    android:fontFamily="@font/misans"
                    android:text="@string/installations_clear_staged"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    android:background="@drawable/button_accent"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/installations_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_4"
            android:paddingBottom="@dimen/space_4"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/installations_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/installations_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_8"
            android:visibility="gone">

            <TextView
                android:id="@+id/installations_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misans"
                android:text="@string/installations_empty_title"
                android:textColor="@color/on_surface"
                android:textAppearance="@style/TextAppearance.Glowberry.Title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/installations_empty_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center"
                android:fontFamily="@font/misans"
                android:text="@string/installations_empty_message"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
        </LinearLayout>
        </FrameLayout>
      <LinearLayout
          android:id="@+id/installations_pagination"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:paddingHorizontal="@dimen/space_4"
          android:paddingVertical="@dimen/space_3"
          android:visibility="gone">

          <TextView
              android:id="@+id/installations_page_label"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:fontFamily="@font/misans"
              android:textColor="@color/text_secondary"
              android:textAppearance="@style/TextAppearance.Glowberry.Caption"
              tools:text="Page 1" />

          <TextView
              android:id="@+id/installations_prev_page"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:minHeight="32dp"
              android:paddingHorizontal="@dimen/space_4"
              android:gravity="center"
              android:fontFamily="@font/misans"
              android:text="@string/installations_prev_page"
              android:textColor="@color/on_surface"
              android:textAppearance="@style/TextAppearance.Glowberry.Caption"
              android:textStyle="bold"
              android:background="@drawable/bg_alpha_chip"
              android:clickable="true"
              android:focusable="true" />

          <TextView
              android:id="@+id/installations_next_page"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:minHeight="32dp"
              android:layout_marginStart="@dimen/space_2"
              android:paddingHorizontal="@dimen/space_4"
              android:gravity="center"
              android:fontFamily="@font/misans"
              android:text="@string/installations_next_page"
              android:textColor="?attr/colorOnPrimary"
              android:textAppearance="@style/TextAppearance.Glowberry.Caption"
              android:textStyle="bold"
              android:background="@drawable/button_accent"
              android:clickable="true"
              android:focusable="true" />
      </LinearLayout>

    </LinearLayout>

    <!--
        Hosts the browser check Monster MCPE requires. Kept in the layout (not created in
        code) so the WebView survives configuration changes with the activity.
    -->
    <FrameLayout
        android:id="@+id/installations_browser_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:visibility="gone">

        <WebView
            android:id="@+id/installations_browser"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="vertical"
            android:padding="@dimen/space_3"
            android:background="@color/background">

            <TextView
                android:id="@+id/installations_browser_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misans"
                android:text="@string/installations_challenge_hint"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

            <TextView
                android:id="@+id/installations_browser_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:minHeight="32dp"
                android:paddingHorizontal="@dimen/space_4"
                android:gravity="center"
                android:fontFamily="@font/misans"
                android:text="@string/cancel"
                android:textColor="@color/on_surface"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:textStyle="bold"
                android:background="@drawable/bg_alpha_chip"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </FrameLayout>
    </FrameLayout>
