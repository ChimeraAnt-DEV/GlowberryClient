<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_2"
    android:layout_marginVertical="@dimen/space_2"
    style="@style/Widget.Chimera.Card"
    android:elevation="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_4">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/version_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/misans"
            android:maxLines="1"
            android:textColor="@color/on_surface"
            android:textAppearance="@style/TextAppearance.Glowberry.Body"
            android:textStyle="bold"
            tools:text="Fresh Animations 1.10.5" />

        <TextView
            android:id="@+id/version_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_hairline"
            android:ellipsize="end"
            android:fontFamily="@font/misans"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
            tools:text="release • 26.1, 26.2 • 631 KB" />
    </LinearLayout>

    <Button
        android:id="@+id/version_download"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:minWidth="0dp"
        android:layout_marginStart="@dimen/space_2"
        android:paddingHorizontal="@dimen/space_4"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:backgroundTint="@color/primary"
        android:fontFamily="@font/misans"
        android:text="@string/modrinth_download_version"
        android:textAllCaps="false"
        android:textColor="@color/on_primary"
        android:textAppearance="@style/TextAppearance.Glowberry.Caption"
        android:textStyle="bold" />
</LinearLayout>