<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher's top navigation bar.

    Structure: a single 48dp row containing (start) the back button, berry logo and wordmark,
    (centre) a horizontally scrollable strip of four tabs — Play, Library, Mods, Settings — and
    (end) the account controls.
    Below the divider sits the screen's own content — this file is only the chrome.

    This layout is only used on a compact window (<600dp); a wider window gets the vertical rail
    (nav_rail.xml) instead, chosen at runtime from the window width by NavLayoutMode (U5).

    The row is a ConstraintLayout rather than a box with three children because the previous
    layout let the wordmark and the tab strip overlap: the name was wrap_content with no line
    limit and the tabs were a wrap_content scroll view centred against it, so on a narrow phone
    (or a Samsung at large font scale) the name wrapped to two lines and slid under the first
    tab. Here the name is pinned between the logo and the tab strip with a hard end constraint,
    one line, an ellipsis and autosize; the tab strip is pinned to the end controls and scrolls;
    and the wordmark is shown only once the window is wide enough to keep it off the tabs, where
    the tabs go icon-only with only the selected label shown. Those three together mean the bar
    cannot collide at any width or font scale.

    Four destinations (U1), not six: Instances/Install/Replay are one Library screen, Cosmetics is
    a profile sheet on Play, and Controller/Skins/Voice live in Settings. A tab that only exists to
    be a section of another tab is what made the old bar too long for a phone.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_bar_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="@dimen/space_2"
        android:paddingEnd="@dimen/space_2">

        <ImageView
            android:id="@+id/nav_back_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="@dimen/space_1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/nav_back"
            android:focusable="true"
            android:padding="@dimen/space_3"
            android:rotation="90"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_down"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/nav_logo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="@dimen/space_hairline"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_glowberry_logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/nav_back_button"
            app:layout_constraintTop_toTopOf="parent" />

        <!--
            The wordmark. Constraints (not a maxWidth) are what keep it off the tabs: it starts
            after the logo and ends where the tab strip starts, so it can never grow under them.
            maxLines + singleLine + ellipsize handle the remaining squeeze; autosize shrinks it
            on very narrow windows. BaseActivity decides whether it is shown from NavLayoutMode:
            on the bar it needs a window at least WORDMARK_WIDTH_DP wide, and on the rail it
            follows the labels. The goneMarginStart on the tab strip is what keeps the tabs from
            butting against the logo when the wordmark is hidden.
        -->
        <TextView
            android:id="@+id/nav_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_marginEnd="@dimen/space_2"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="@font/misans"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/accent_text"
            android:textAppearance="@style/TextAppearance.Glowberry.Title"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/nav_tab_scroll"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@id/nav_logo"
            app:layout_constraintTop_toTopOf="parent" />


        <!--
            Tabs live in a scroll view so every labelled entry always fits; the strip is pinned
            between the wordmark's end and the start of the news/account controls, which is what
            guarantees it cannot slide under either. fillViewport lets the row stretch so the
            tap targets stay full-height when there is spare room.
        -->
        <HorizontalScrollView
            android:id="@+id/nav_tab_scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/nav_trailing"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@id/nav_app_name"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="@dimen/space_1">

            <!--
                The tab row and its sliding accent indicator share a FrameLayout so the indicator
                can sit under the active tab and scroll with the strip. HorizontalScrollView takes
                a single child, so this wrapper is what allows the overlay.
            -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/nav_tab_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/nav_tab_launch"
                    style="@style/Widget.Chimera.NavTab"
                    android:drawableStart="@drawable/ic_nav_launch"
                    android:text="@string/nav_launch" />

                <TextView
                    android:id="@+id/nav_tab_library"
                    style="@style/Widget.Chimera.NavTab"
                    android:drawableStart="@drawable/ic_nav_instances"
                    android:text="@string/nav_library" />

                <TextView
                    android:id="@+id/nav_tab_mods"
                    style="@style/Widget.Chimera.NavTab"
                    android:drawableStart="@drawable/ic_inbuilt_mods"
                    android:text="@string/nav_mods" />

                <TextView
                    android:id="@+id/nav_tab_settings"
                    style="@style/Widget.Chimera.NavTab"
                    android:drawableStart="@drawable/ic_nav_settings"
                    android:text="@string/nav_settings" />

            </LinearLayout>

                <!-- The sliding accent indicator, positioned by BaseActivity under the active tab. -->
                <View
                    android:id="@+id/nav_active_indicator"
                    android:layout_width="28dp"
                    android:layout_height="3dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/nav_active_indicator"
                    android:visibility="invisible" />
            </FrameLayout>
        </HorizontalScrollView>

        <!--
            Trailing controls sit hard against the end; the tab strip is constrained to their
            start, so their space is reserved before the strip is measured and they can never be
            pushed off screen.
        -->
        <LinearLayout
            android:id="@+id/nav_trailing"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <Button
                android:id="@+id/nav_sign_in_button"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="34dp"
                android:paddingHorizontal="@dimen/space_4"
                android:paddingVertical="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:fontFamily="@font/misans"
                android:gravity="center"
                android:includeFontPadding="false"
                android:backgroundTint="@color/primary"
                android:text="@string/sign_in"
                android:textColor="@color/on_primary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/nav_account_avatar_container"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:visibility="gone">

                <com.microsoft.xbox.idp.toolkit.CircleImageView
                    android:id="@+id/nav_account_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/xbox_avatar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_minecraft_cube" />

                <ProgressBar
                    android:id="@+id/nav_avatar_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="true"
                    android:visibility="gone" />
            </FrameLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/nav_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

</LinearLayout>
