<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    android:background="@drawable/bg_instance_card"
    android:orientation="vertical"
    android:padding="@dimen/space_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/installation_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/misans"
            android:maxLines="2"
            android:textColor="@color/on_surface"
            android:textAppearance="@style/TextAppearance.Glowberry.Title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/installation_release_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="22dp"
            android:paddingHorizontal="@dimen/space_3"
            android:gravity="center"
            android:fontFamily="@font/misans"
            android:text="@string/installations_release_tag"
            android:textColor="?attr/colorPrimary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
            android:textStyle="bold"
            android:background="@drawable/bg_release_tag"
            android:visibility="gone" />

        <TextView
            android:id="@+id/installation_installed_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="22dp"
            android:layout_marginStart="@dimen/space_2"
            android:paddingHorizontal="@dimen/space_3"
            android:gravity="center"
            android:fontFamily="@font/misans"
            android:text="@string/installations_installed_tag"
            android:textColor="@color/on_surface"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
            android:textStyle="bold"
            android:background="@drawable/bg_alpha_chip"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/installation_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/misans"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

        <TextView
            android:id="@+id/installation_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="34dp"
            android:paddingHorizontal="@dimen/space_4"
            android:gravity="center"
            android:fontFamily="@font/misans"
            android:text="@string/installations_download"
            android:textColor="?attr/colorOnPrimary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
            android:textStyle="bold"
            android:background="@drawable/button_accent"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/installation_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="@dimen/space_3"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

</LinearLayout>
