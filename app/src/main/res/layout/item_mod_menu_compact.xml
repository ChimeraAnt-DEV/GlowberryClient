<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginTop="3dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="3dp"
    android:defaultFocusHighlightEnabled="false"
    app:cardBackgroundColor="@color/mod_menu_bg_surface2"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="54dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/mod_card_accent"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="#00000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="54dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/mod_card_icon"
                android:layout_width="26dp"
                android:layout_height="26dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/mod_card_status_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_mod_status_dot"
                        android:visibility="gone" />

                <TextView
                    android:id="@+id/mod_card_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/mod_menu_text_primary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/mod_card_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/mod_menu_text_secondary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Micro"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mod_card_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/mod_menu_text_secondary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mod_card_unavailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_mod_unavailable"
                    android:gravity="center"
                    android:minHeight="20dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/mod_unavailable_message"
                    android:textColor="@color/mod_menu_state_error"
                    android:textAppearance="@style/TextAppearance.Glowberry.Micro"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- M2: the state control is the same pill switch as the full row, so the compact
                 list and the grid cannot disagree about how a module is toggled. -->
            <org.chimeramc.client.core.mods.inbuilt.overlay.ModMenuSwitchView
                android:id="@+id/mod_card_switch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/mod_status_disabled" />

            <!-- M3: an action row's control. Never shown with the switch. -->
            <ImageView
                android:id="@+id/mod_card_chevron"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/mod_menu_text_tertiary"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/mod_card_config"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:defaultFocusHighlightEnabled="false"
                android:padding="5dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/mod_menu_text_secondary" />

            <ImageButton
                android:id="@+id/mod_card_favorite"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:defaultFocusHighlightEnabled="false"
                android:padding="5dp"
                android:src="@drawable/ic_star"
                android:tint="@color/mod_menu_text_secondary" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>