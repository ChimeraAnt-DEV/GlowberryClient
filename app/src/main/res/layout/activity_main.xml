<?xml version="1.0" encoding="utf-8"?>
<!--
    The Launch tab. A vertical page column (max 600dp wide, so a widescreen tablet cannot stretch
    it) holds the section blocks, and the launch controls live in one docked bar at the bottom of
    the screen rather than floating loose in the scroll.

    The ids the activity binds are unchanged: launch_button, select_version_button,
    text_minecraft_version, progress_loader, last_played_card, the three quick_*_card tiles and the
    section_* headers.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="@color/surface_dark"
            app:statusBarScrim="@color/surface_dark">

            <!-- Launch Tab Header: the account row only. The launcher name and its news button
                 were removed from this tab by request; the brand is carried by the nav bar. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_4"
                android:background="@drawable/gradient_header"
                app:layout_collapseMode="parallax">

                <LinearLayout
                    android:id="@+id/account_status_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_card"
                    android:padding="@dimen/space_3"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.microsoft.xbox.idp.toolkit.CircleImageView
                        android:id="@+id/header_account_avatar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:visibility="gone" 
                        android:importantForAccessibility="no"
                        />

                    <TextView
                        android:id="@+id/header_account_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_3"
                        android:text="@string/not_signed_in"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.Glowberry.Label" />

                    <Button
                        android:id="@+id/header_sign_in_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="38dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingHorizontal="@dimen/space_4"
                        android:paddingVertical="@dimen/space_2"
                        android:background="@drawable/button_accent"
                        android:fontFamily="@font/misans"
                        android:text="@string/sign_in"
                        android:textColor="@color/on_header_gradient"
                        android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                        android:textStyle="bold"
                        android:lineSpacingExtra="0dp"
                        android:includeFontPadding="true"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/launch_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_dock_clearance"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_4"
            android:paddingTop="@dimen/space_4">

            <LinearLayout
                android:id="@+id/launch_content_column"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/page_max_width">

                <!-- The head pod: the interactive anchor. A live 3D bust of the player's skin in a
                     glass disc; hover pauses the idle spin, drag rotates, click opens the skin
                     customizer. It sits above the hero panel so it reads as the tab's centrepiece. -->
                <include
                    layout="@layout/include_launch_head_pod"
                    android:id="@+id/launch_head_pod_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Hero panel: live 3D player preview (left) + instance identity and stats (right). -->
                <include
                    layout="@layout/include_hero_panel"
                    android:id="@+id/launch_hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/include_section_header"
                    android:id="@+id/section_quick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:layout_marginBottom="@dimen/space_3" />

                <!-- Quick-toggle cards: AntEgg packs, Voice, Replays, each with a live status. -->
                <include
                    layout="@layout/include_launch_toggles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Content Library Section -->
                <include
                    layout="@layout/include_section_header"
                    android:id="@+id/section_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:layout_marginBottom="@dimen/space_3" />

                <LinearLayout
                    android:id="@+id/contentWorldsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:background="@drawable/glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_4"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="@dimen/space_3"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_minecraft_cube"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/worlds_title"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.Glowberry.Body" />

                    <TextView
                        android:id="@+id/contentWorldsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Label" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:alpha="0.7"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentResourcePacksRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_4"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="@dimen/space_3"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_content"
                        app:tint="@color/accent_sky" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/resource_packs"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.Glowberry.Body" />

                    <TextView
                        android:id="@+id/contentResourcePacksCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Label" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:alpha="0.7"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentBehaviorPacksRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_4"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="@dimen/space_3"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_behavior"
                        app:tint="@color/secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/behavior_packs"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.Glowberry.Body" />

                    <TextView
                        android:id="@+id/contentBehaviorPacksCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Label" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:alpha="0.7"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <!-- More Section -->
                <include
                    layout="@layout/include_section_header"
                    android:id="@+id/section_more"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:layout_marginBottom="@dimen/space_3" />

                <LinearLayout
                    android:id="@+id/miscCurseforgeRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:background="@drawable/glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_4"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="@dimen/space_3"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_qa_curseforge"
                        app:tint="@color/accent_violet" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/curseforge_title"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.Glowberry.Body" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:alpha="0.7"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/miscModHubRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_4"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="@dimen/space_3"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_plugin"
                        app:tint="@color/accent_sky" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mod_hub_title"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.Glowberry.Body" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:alpha="0.7"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/miscDiscordRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_4"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="@dimen/space_3"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_discord"
                        app:tint="@color/accent_sky" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/discord_join"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.Glowberry.Body" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:alpha="0.7"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/miscAccountsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_4"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="@dimen/space_3"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_qa_account"
                        app:tint="@color/secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/accounts_title"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.Glowberry.Body" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:alpha="0.7"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/miscQuickLaunchRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/glass_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_4"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="@dimen/space_3"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_qa_launch"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/quick_launch"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.Glowberry.Body" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:alpha="0.7"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tipText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Docked launch controls, pinned to the bottom of the screen. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingHorizontal="@dimen/space_4"
        android:paddingBottom="@dimen/space_4">

        <!-- The quick dock: Mods, Cosmetics and the radial wheel, one tap away. -->
        <include
            layout="@layout/include_launch_quickdock"
            android:id="@+id/launch_quickdock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_3"
            app:layout_constraintBottom_toTopOf="@id/launch_dock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <include
            layout="@layout/include_launch_dock"
            android:id="@+id/launch_dock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_max="@dimen/dock_max_width" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
