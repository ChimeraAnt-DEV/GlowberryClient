<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_4"
        android:paddingTop="@dimen/space_4"
        android:paddingBottom="@dimen/space_2">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misans"
            android:text="@string/mod_hub_title"
            android:textColor="@color/on_surface"
            android:textAppearance="@style/TextAppearance.Glowberry.Display"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mod_hub_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_hairline"
            android:fontFamily="@font/misans"
            android:text="@string/mod_hub_subtitle"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

        <!-- Two sources, one screen: browsing an index vs. importing what is already on disk. -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/mod_hub_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            app:tabMode="fixed"
            app:tabGravity="fill" />
    </LinearLayout>

    <!-- Modrinth browser -->
    <FrameLayout
        android:id="@+id/mod_hub_modrinth_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modrinth_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_4"
                android:layout_marginBottom="@dimen/space_2"
                android:background="@drawable/bg_diagnostics_banner"
                android:fontFamily="@font/misans"
                android:padding="@dimen/space_3"
                android:text="@string/modrinth_java_warning"
                android:textColor="@color/on_surface"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_4"
                android:paddingBottom="@dimen/space_2">

                <EditText
                    android:id="@+id/modrinth_search_box"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_box"
                    android:drawableStart="@drawable/ic_search"
                    android:drawablePadding="@dimen/space_3"
                    android:drawableTint="@color/on_surface"
                    android:fontFamily="@font/misans"
                    android:hint="@string/modrinth_hub_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingHorizontal="@dimen/space_4"
                    android:textColor="@color/on_surface"
                    android:textColorHint="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/modrinth_sort_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:minHeight="40dp"
                    android:text="@string/sort"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/divider" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_4"
                android:paddingBottom="@dimen/space_2"
                android:scrollbars="none">

                <RadioGroup
                    android:id="@+id/modrinth_type_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/modrinth_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="@dimen/space_3" />

                <ProgressBar
                    android:id="@+id/modrinth_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/modrinth_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_8"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/misans"
                        android:text="@string/no_mods_found"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.Glowberry.Title"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Downloads scanner -->
    <FrameLayout
        android:id="@+id/mod_hub_downloads_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_4"
                android:paddingBottom="@dimen/space_2">

                <TextView
                    android:id="@+id/downloads_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    tools:text="3 importable of 5 found" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/downloads_import_all_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/downloads_import_all"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/downloads_scan_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:minHeight="40dp"
                    android:text="@string/downloads_scan"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/divider" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/downloads_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="@dimen/space_3" />

                <ProgressBar
                    android:id="@+id/downloads_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/downloads_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_8"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/misans"
                        android:text="@string/downloads_empty_title"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.Glowberry.Title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:gravity="center"
                        android:fontFamily="@font/misans"
                        android:text="@string/downloads_empty_message"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
