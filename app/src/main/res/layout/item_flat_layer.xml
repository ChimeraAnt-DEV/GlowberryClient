<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/space_1"
    style="@style/Widget.Chimera.Card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/space_2">

    <TextView
        android:id="@+id/layer_number"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:background="@drawable/bg_circle"
        android:fontFamily="@font/misans"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/on_primary"
        android:textAppearance="@style/TextAppearance.Glowberry.Caption"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/block_edit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_2"
        android:layout_weight="1"
        android:background="@drawable/bg_edit_text"
        android:fontFamily="@font/misans"
        android:hint="minecraft:stone"
        android:inputType="text"
        android:maxLines="1"
        android:padding="@dimen/space_2"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/outline"
        android:textAppearance="@style/TextAppearance.Glowberry.Label" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_2"
        android:fontFamily="@font/misans"
        android:text="×"
        android:textColor="@color/on_surface"
        android:textAppearance="@style/TextAppearance.Glowberry.Body" />

    <EditText
        android:id="@+id/count_edit"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_1"
        android:background="@drawable/bg_edit_text"
        android:fontFamily="@font/misans"
        android:gravity="center"
        android:inputType="number"
        android:maxLength="3"
        android:padding="@dimen/space_2"
        android:text="1"
        android:textColor="@color/on_surface"
        android:textAppearance="@style/TextAppearance.Glowberry.Label" />

</LinearLayout>
