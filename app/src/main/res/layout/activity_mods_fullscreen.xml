<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="15dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/full_mods_title"
            android:fontFamily="@font/misans"
            android:textColor="@color/primary"
            android:textAppearance="@style/TextAppearance.Glowberry.Display"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="0dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_mods"
                        android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/misans" />

                    <TextView
                        android:id="@+id/total_mods_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.Glowberry.Title"
                        android:textColor="@color/accent_text"
                        android:fontFamily="@font/misans"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enabled_mods"
                        android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                        android:textColor="@color/text_secondary"
                        android:fontFamily="@font/misans" />

                    <TextView
                        android:id="@+id/enabled_mods_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.Glowberry.Title"
                        android:textColor="@color/accent_text"
                        android:fontFamily="@font/misans"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/mod_menu_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:minWidth="136dp"
                android:backgroundTint="@color/secondary"
                android:text="@string/mod_menu"
                android:textColor="@color/on_secondary"
                android:paddingHorizontal="18dp"
                android:layout_marginStart="10dp"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/misans" />

            <Button
                android:id="@+id/javabridge_fullscreen_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:minWidth="0dp"
                android:backgroundTint="@color/secondary"
                android:text="@string/javabridge_title"
                android:textColor="@color/on_secondary"
                android:paddingHorizontal="16dp"
                android:layout_marginStart="10dp"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/misans" />

            <Button
                android:id="@+id/mod_hub_fullscreen_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:minWidth="0dp"
                android:backgroundTint="@color/secondary"
                android:text="@string/mod_hub_title"
                android:textColor="@color/on_secondary"
                android:paddingHorizontal="16dp"
                android:layout_marginStart="10dp"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/misans" />

            <Button
                android:id="@+id/add_mod_fullscreen_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:minWidth="120dp"
                android:backgroundTint="@color/primary"
                android:text="@string/add_mod"
                android:textColor="@color/on_primary"
                android:paddingHorizontal="18dp"
                android:layout_marginStart="10dp"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/misans" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="0dp">



            <LinearLayout
                android:id="@+id/mod_load_diagnostics_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_diagnostics_banner"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/mod_load_diagnostics_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/misans"
                    android:text="@string/mod_load_diagnostics_title"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textAppearance="@style/TextAppearance.Glowberry.Body"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mod_load_diagnostics_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/misans"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

                <TextView
                    android:id="@+id/mod_load_diagnostics_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/misans"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

                <TextView
                    android:id="@+id/mod_load_diagnostics_dismiss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/misans"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp"
                    android:text="@string/mod_load_diagnostics_dismiss"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mods_recycler_fullscreen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="8dp" />

            <LinearLayout
                android:id="@+id/empty_mods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_modules"
                    android:alpha="0.4"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/misans"
                    android:text="@string/empty_mods_title"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/misans"
                    android:gravity="center"
                    android:text="@string/empty_mods_message"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Label" />

            </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
</FrameLayout>
