<?xml version="1.0" encoding="utf-8"?>
<!--
    One touch Mod Menu module row (M1, M2, M5, M10).

    The row is a module, so it carries a SWITCH — never a button. The distinction is the whole
    point of the phase: an entry with an enable state must show its state, and a one-shot action
    (see the "Actions" section of the menu) carries a chevron instead. Both controls are never on
    one row.

    Geometry comes from ModMenuMetrics: a 64dp comfortable row, a 52x32dp pill switch, and a 48dp
    touch target even though the switch's visual is smaller. Colours come from the ModMenuPalette
    tokens; nothing here embeds a raw hex.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mod_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginTop="3dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="3dp"
    android:clickable="true"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="false"
    app:cardBackgroundColor="@color/mod_menu_bg_surface2"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:id="@+id/mod_card_accent"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#00000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:id="@+id/mod_card_icon_tile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_vip_icon_tile">

                <ImageView
                    android:id="@+id/mod_card_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_modules"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/mod_card_status_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_mod_status_dot"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/mod_card_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/mod_menu_text_primary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Body"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/mod_card_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/mod_menu_text_secondary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mod_card_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/mod_menu_text_secondary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mod_card_unavailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:letterSpacing="0.08"
                    android:text="@string/mod_unavailable_message"
                    android:textColor="@color/mod_menu_state_error"
                    android:textAppearance="@style/TextAppearance.Glowberry.Micro"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/mod_card_favorite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_vip_icon_button"
                android:contentDescription="@string/mod_menu_favorite"
                android:defaultFocusHighlightEnabled="false"
                android:padding="13dp"
                android:src="@drawable/ic_star"
                android:tint="@color/mod_menu_text_secondary" />

            <!-- The state control (M2). A pill switch, not a status pill: it shows the state AND
                 changes it. The view reserves a 48dp touch target around the 52x32dp visual. -->
            <org.chimeramc.client.core.mods.inbuilt.overlay.ModMenuSwitchView
                android:id="@+id/mod_card_switch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/mod_status_disabled" />

            <!-- An action row's control (M3). Never shown on the same row as the switch. -->
            <ImageView
                android:id="@+id/mod_card_chevron"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/mod_menu_text_tertiary"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/mod_card_config"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_vip_icon_button"
                android:contentDescription="@string/vip_configure"
                android:defaultFocusHighlightEnabled="false"
                android:padding="13dp"
                android:src="@drawable/ic_settings"
                android:tint="@color/mod_menu_text_secondary"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
