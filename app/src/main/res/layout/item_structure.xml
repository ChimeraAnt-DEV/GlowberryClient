<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/space_3"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/structure_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textAppearance="@style/TextAppearance.Glowberry.Title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/structure_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AAAAAA"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
            android:layout_marginTop="@dimen/space_hairline" />

    </LinearLayout>

    <Button
        android:id="@+id/export_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="36dp"
        android:text="@string/extract"
        android:textAppearance="@style/TextAppearance.Glowberry.Caption"
        android:backgroundTint="@color/primary"
        android:textColor="@android:color/white" />

</LinearLayout>
