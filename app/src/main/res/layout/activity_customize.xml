<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/customize_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_6"
        android:paddingEnd="@dimen/space_6"
        android:paddingTop="@dimen/space_4">

        <TextView
            android:id="@+id/customize_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_customize"
            android:fontFamily="@font/misans"
            android:textColor="@color/primary"
            android:textAppearance="@style/TextAppearance.Glowberry.Display"
            android:textStyle="bold" />

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_6"
        android:paddingEnd="@dimen/space_6"
        android:layout_marginTop="@dimen/space_2"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/customize_tab_controller"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:paddingHorizontal="@dimen/space_4"
                android:gravity="center"
                android:fontFamily="@font/misans"
                android:text="@string/customize_tab_controller"
                android:textColor="@color/on_primary"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:textStyle="bold"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/customize_tab_skins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:layout_marginStart="@dimen/space_2"
                android:paddingHorizontal="@dimen/space_4"
                android:gravity="center"
                android:fontFamily="@font/misans"
                android:text="@string/customize_tab_skins"
                android:textColor="@color/on_surface"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/customize_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
