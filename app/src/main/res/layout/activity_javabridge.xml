<?xml version="1.0" encoding="utf-8"?>
<!--
    JavaBridge: import a Java Edition .jar, see a portability report, and port it to .AntEgg.

    The screen is a vertical scroll of plain cards rather than a tab host: the flow is linear
    (inspect -> score -> port -> review), so a tab bar would imply navigation the user does not
    need. Each section is a Widget.Chimera.Card so the geometry comes from the shared card tokens.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_4"
        android:paddingTop="@dimen/space_4"
        android:paddingBottom="@dimen/space_6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misans"
                android:text="@string/javabridge_title"
                android:textColor="@color/on_surface"
                android:textAppearance="@style/TextAppearance.Glowberry.Display"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_hairline"
                android:fontFamily="@font/misans"
                android:text="@string/javabridge_subtitle"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

            <!-- Honest scope: this rewrites mods, it does not run Java Edition. -->
            <TextView
                android:id="@+id/javabridge_scope_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:background="@drawable/bg_diagnostics_banner"
                android:fontFamily="@font/misans"
                android:padding="@dimen/space_3"
                android:text="@string/javabridge_scope_note"
                android:textColor="@color/on_surface"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/javabridge_import_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/javabridge_import_jar" />

                <Button
                    android:id="@+id/javabridge_setup_button"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:text="@string/javabridge_setup" />
            </LinearLayout>

            <!-- The report card is hidden until a mod has been inspected. -->
            <LinearLayout
                android:id="@+id/javabridge_report_card"
                style="@style/Widget.Chimera.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/javabridge_mod_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                    android:textStyle="bold"
                    tools:text="Cool Mod" />

                <TextView
                    android:id="@+id/javabridge_mod_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_hairline"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    tools:text="Fabric \u00b7 1.2.0 \u00b7 by Alice" />

                <!-- Portability score pill. -->
                <TextView
                    android:id="@+id/javabridge_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:background="@drawable/bg_mod_page_badge"
                    android:fontFamily="@font/misans"
                    android:paddingHorizontal="@dimen/space_3"
                    android:paddingVertical="@dimen/space_1"
                    android:textColor="@color/primary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    android:textStyle="bold"
                    tools:text="Portability: High" />

                <TextView
                    android:id="@+id/javabridge_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Label"
                    tools:text="This is a small, data-driven mod." />

                <TextView
                    android:id="@+id/javabridge_reimplementation_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:background="@drawable/bg_diagnostics_banner"
                    android:fontFamily="@font/misans"
                    android:padding="@dimen/space_3"
                    android:text="@string/javabridge_reimplementation_warning"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:fontFamily="@font/misans"
                    android:text="@string/javabridge_what_ported"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Label"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/javabridge_kept_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/javabridge_partial_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:fontFamily="@font/misans"
                    android:text="@string/javabridge_what_partial"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Label"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/javabridge_partial_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/javabridge_dropped_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:fontFamily="@font/misans"
                    android:text="@string/javabridge_what_dropped"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Label"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/javabridge_dropped_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:fontFamily="@font/misans"
                    android:text="@string/javabridge_mapped_apis"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Label"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/javabridge_mapped_apis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    tools:text="Item.Settings \u2192 AntEggItemDef\nRegistry.register \u2192 AntEggRegistry.register" />

                <Button
                    android:id="@+id/javabridge_port_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:minHeight="48dp"
                    android:text="@string/javabridge_port_button" />
            </LinearLayout>

            <!-- Skeleton shimmer while the jar is being read; no spinner. -->
            <LinearLayout
                android:id="@+id/javabridge_loading"
                style="@style/Widget.Chimera.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="gone">

                <TextView
                    android:id="@+id/javabridge_loading_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_3"
                    android:fontFamily="@font/misans"
                    android:text="@string/javabridge_inspecting"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

                <View
                    android:layout_width="180dp"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_skeleton_bar" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="@dimen/space_3"
                    android:background="@drawable/bg_skeleton_bar" />

                <View
                    android:layout_width="240dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="@dimen/space_2"
                    android:background="@drawable/bg_skeleton_bar" />
            </LinearLayout>

            <!-- Empty state: illustrative, not a blank screen. -->
            <LinearLayout
                android:id="@+id/javabridge_empty_state"
                style="@style/Widget.Chimera.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_8">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:alpha="0.85"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_code"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:fontFamily="@font/misans"
                    android:text="@string/javabridge_empty_title"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:fontFamily="@font/misans"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/space_6"
                    android:text="@string/javabridge_empty_body"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
