<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    style="@style/Widget.Chimera.Card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pack_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misans"
                android:text="@string/resource_pack_name_placeholder"
                android:textColor="@color/on_surface"
                android:textAppearance="@style/TextAppearance.Glowberry.Title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pack_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/misans"
                android:text="@string/resource_pack_size_placeholder"
                android:textColor="@color/on_surface"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

        </LinearLayout>

        <Button
            android:id="@+id/pack_export_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/primary"
            android:fontFamily="@font/misans"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="@string/export"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

        <Button
            android:id="@+id/pack_transfer_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/secondary"
            android:fontFamily="@font/misans"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="@string/transfer"
            android:textAllCaps="false"
            android:textColor="@color/on_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

        <Button
            android:id="@+id/pack_delete_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/error"
            android:fontFamily="@font/misans"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="@string/delete_pack"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

    </LinearLayout>

    <TextView
        android:id="@+id/pack_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/misans"
        android:text="@string/resource_pack_description_placeholder"
        android:textColor="@color/on_surface"
        android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

</LinearLayout>
