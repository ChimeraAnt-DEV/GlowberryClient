<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_6"
        android:paddingEnd="@dimen/space_6"
        android:paddingTop="@dimen/space_4"
        android:paddingBottom="@dimen/space_6">

        <TextView
            android:id="@+id/instances_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_instance_title"
            android:fontFamily="@font/misans"
            android:textColor="@color/primary"
            android:textAppearance="@style/TextAppearance.Glowberry.Display"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/filter_tabs_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/filter_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:paddingHorizontal="@dimen/space_4"
                    android:gravity="center"
                    android:text="@string/filter_all"
                    android:fontFamily="@font/misans"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    android:textStyle="bold"
                    android:textColor="@color/on_primary"
                    android:background="@drawable/bg_filter_chip"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/filter_custom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:layout_marginStart="@dimen/space_2"
                    android:paddingHorizontal="@dimen/space_4"
                    android:gravity="center"
                    android:text="@string/filter_custom"
                    android:fontFamily="@font/misans"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    android:textColor="@color/on_surface"
                    android:background="@drawable/bg_filter_chip"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_3"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_search_field_light"
                android:paddingHorizontal="@dimen/space_3">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_2"
                    android:background="@null"
                    android:hint="@string/search_instances_hint"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Label"
                    android:fontFamily="@font/misans"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sort_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="32dp"
                android:layout_marginStart="@dimen/space_3"
                android:paddingHorizontal="@dimen/space_3"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_sort_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/sort_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="@string/sort_version_newest"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
            </LinearLayout>

            <TextView
                android:id="@+id/instance_count_badge"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:minHeight="28dp"
                android:layout_marginStart="@dimen/space_2"
                android:gravity="center"
                android:text="0"
                android:fontFamily="@font/misans"
                android:textColor="@color/on_surface"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:textStyle="bold"
                android:background="@drawable/bg_count_badge" />

        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_batch_backup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:paddingHorizontal="@dimen/space_4"
                    android:gravity="center"
                    android:text="@string/instance_batch_backup_button"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_primary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    android:textStyle="bold"
                    android:background="@drawable/bg_filter_chip"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_import_backup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:layout_marginStart="@dimen/space_3"
                    android:paddingHorizontal="@dimen/space_4"
                    android:gravity="center"
                    android:text="@string/instance_import_backup_button"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_primary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    android:textStyle="bold"
                    android:background="@drawable/bg_filter_chip"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btn_import_apk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:layout_marginStart="@dimen/space_3"
                    android:paddingHorizontal="@dimen/space_4"
                    android:gravity="center"
                    android:text="@string/import_apk"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_primary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    android:textStyle="bold"
                    android:background="@drawable/bg_filter_chip"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/space_4">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/instances_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/space_2" />

            <LinearLayout
                android:id="@+id/empty_instances"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_8"
                android:visibility="gone">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_minecraft_cube"
                    android:alpha="0.4"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:fontFamily="@font/misans"
                    android:text="@string/empty_instances_title"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:fontFamily="@font/misans"
                    android:gravity="center"
                    android:text="@string/empty_instances_message"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Label" />

            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
</LinearLayout>
