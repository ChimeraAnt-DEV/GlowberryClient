<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controller_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_6"
        android:paddingEnd="@dimen/space_6"
        android:paddingTop="@dimen/space_4"
        android:paddingBottom="@dimen/space_6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/controller_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/controller_title"
                android:fontFamily="@font/misans"
                android:textColor="@color/primary"
                android:textAppearance="@style/TextAppearance.Glowberry.Display"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/controller_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_3"
                android:fontFamily="@font/misans"
                android:text="@string/controller_status_none"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:gravity="end" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/space_2">

            <org.chimeramc.client.launcher.ui.views.Controller3DView
                android:id="@+id/controller_illustration"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/controller_illustration_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="@dimen/space_2"
                android:fontFamily="@font/misans"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

        </FrameLayout>

        <TextView
            android:id="@+id/controller_profile_section_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/controller_profiles_title"
            android:fontFamily="@font/misans"
            android:textColor="@color/primary"
            android:textAppearance="@style/TextAppearance.Glowberry.Title"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/controller_profile_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/empty_controller_profiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            style="@style/Widget.Chimera.Card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/space_3"
            android:visibility="gone">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_nav_controller"
                android:contentDescription="@string/controller_profiles_title" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_3"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/misans"
                    android:text="@string/empty_controller_profiles_title"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Label"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_hairline"
                    android:fontFamily="@font/misans"
                    android:text="@string/empty_controller_profiles_message"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/controller_profile_create"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_2"
                android:gravity="center"
                android:fontFamily="@font/misans"
                android:text="@string/controller_profile_create"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/controller_profile_rename"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_2"
                android:gravity="center"
                android:fontFamily="@font/misans"
                android:text="@string/controller_profile_rename"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:textColor="@color/on_surface"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/controller_profile_duplicate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_2"
                android:gravity="center"
                android:fontFamily="@font/misans"
                android:text="@string/controller_profile_duplicate"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:textColor="@color/on_surface"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/controller_profile_delete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:layout_weight="1"
                android:gravity="center"
                android:fontFamily="@font/misans"
                android:text="@string/controller_profile_delete"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:textColor="@color/on_surface"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/controller_next_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:fontFamily="@font/misans"
                android:text="@string/controller_next"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/controller_edit_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_2"
                android:gravity="center"
                android:fontFamily="@font/misans"
                android:text="@string/controller_edit"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true" />

                </LinearLayout>

        <!-- Import/export and per-instance binding live on their own row so the profile row
             above does not have to squeeze seven actions into one line on a phone. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/controller_profile_export"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_2"
                android:gravity="center"
                android:fontFamily="@font/misans"
                android:text="@string/controller_export_profile"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:textColor="@color/on_surface"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/controller_profile_import"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:layout_weight="1"
                android:gravity="center"
                android:fontFamily="@font/misans"
                android:text="@string/controller_import_profile"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:textColor="@color/on_surface"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <TextView
            android:id="@+id/controller_bind_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:fontFamily="@font/misans"
            android:text="@string/controller_bind_hint"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

        <!-- Anti-drift lives on this screen rather than inside the editor dialog: calibration
             samples live motion events, and a modal dialog would cover the pad and block them. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/misans"
                    android:text="@string/controller_antidrift_title"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Label"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_hairline"
                    android:fontFamily="@font/misans"
                    android:text="@string/controller_antidrift_summary"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
            </LinearLayout>

            <android.widget.Switch
                android:id="@+id/controller_antidrift_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_3" />

        </LinearLayout>

        <TextView
            android:id="@+id/controller_calibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center"
            android:fontFamily="@font/misans"
            android:text="@string/controller_calibrate"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:background="@drawable/bg_filter_chip"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/controller_antidrift_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:fontFamily="@font/misans"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/controller_bind_instance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_2"
                android:gravity="center"
                android:fontFamily="@font/misans"
                android:text="@string/controller_bind_instance"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:textColor="@color/on_surface"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/controller_bind_clear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:layout_weight="1"
                android:gravity="center"
                android:fontFamily="@font/misans"
                android:text="@string/controller_bind_clear"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:textColor="@color/on_surface"
                android:background="@drawable/bg_filter_chip"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>
</LinearLayout>
