<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_hairline">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/rename_version_message"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textAppearance="@style/TextAppearance.Glowberry.Body"
        android:layout_marginBottom="@dimen/space_3"/>

    <EditText
        android:id="@+id/edit_version_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_3"
        android:textColor="?attr/colorOnSurface"
        android:textAppearance="@style/TextAppearance.Glowberry.Title"
        android:singleLine="true"
        android:inputType="text"
        android:background="@drawable/bg_edit_text"
        android:hint="@string/new_version_name"
        android:textColorHint="?attr/colorOnSurfaceVariant"/>

    <TextView
        android:id="@+id/text_version_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/name_invalid"
        android:textColor="@color/status_danger_soft"
        android:textAppearance="@style/TextAppearance.Glowberry.Caption"
        android:visibility="gone"
        android:layout_marginTop="@dimen/space_1" />

</LinearLayout>
