<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_4"
        android:paddingTop="@dimen/space_4"
        android:paddingBottom="@dimen/space_2">

        <TextView
            android:id="@+id/modrinth_detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misans"
            android:textColor="@color/on_surface"
            android:textAppearance="@style/TextAppearance.Glowberry.Display"
            android:textStyle="bold"
            tools:text="Fresh Animations" />

        <TextView
            android:id="@+id/modrinth_detail_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_hairline"
            android:fontFamily="@font/misans"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
            tools:text="by FreshLX • 47.3M downloads" />

        <TextView
            android:id="@+id/modrinth_detail_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:fontFamily="@font/misans"
            android:textColor="@color/on_surface"
            android:textAppearance="@style/TextAppearance.Glowberry.Label"
            tools:text="Make your game like the trailers!" />

        <TextView
            android:id="@+id/modrinth_detail_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:background="@drawable/bg_diagnostics_banner"
            android:fontFamily="@font/misans"
            android:padding="@dimen/space_3"
            android:text="@string/modrinth_java_warning"
            android:textColor="@color/on_surface"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:fontFamily="@font/misans"
            android:text="@string/modrinth_versions_title"
            android:textColor="@color/on_surface"
            android:textAppearance="@style/TextAppearance.Glowberry.Title"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/modrinth_versions_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_3" />

        <ProgressBar
            android:id="@+id/modrinth_versions_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/modrinth_versions_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:fontFamily="@font/misans"
            android:padding="@dimen/space_8"
            android:text="@string/modrinth_no_versions"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Label"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>