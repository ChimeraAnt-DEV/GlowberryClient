<?xml version="1.0" encoding="utf-8"?>
<!--
    A reusable Launch-tab section header: a gradient "blocker" marker, a title and an optional
    trailing action ("View all"), set on a soft glass plate so each section reads as its own titled
    block rather than a label floating over the page.

    The trailing action keeps the id @id/section_action so every include binds the same view and
    the activity can wire whichever sections need one. A section that does not want the action
    sets @string/empty_string and the activity hides it, which keeps one layout instead of three
    near-identical copies that drift.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/section_header_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_3"
    android:paddingVertical="@dimen/space_2">

    <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/section_marker" />

        <ImageView
            android:id="@+id/section_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            app:tint="@color/on_header_gradient" />
    </FrameLayout>

    <TextView
        android:id="@+id/section_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_weight="1"
        android:fontFamily="@font/misans"
        android:letterSpacing="0.01"
        android:textColor="@color/on_surface"
        android:textAppearance="@style/TextAppearance.Glowberry.Title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/section_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/misans"
        android:paddingHorizontal="@dimen/space_2"
        android:paddingVertical="@dimen/space_1"
        android:textColor="@color/primary"
        android:textAppearance="@style/TextAppearance.Glowberry.Caption"
        android:visibility="gone" />
</LinearLayout>
