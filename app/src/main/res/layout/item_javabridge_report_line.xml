<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the portability diff: a tier dot, the feature name, and the explanation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/space_1">

    <View
        android:id="@+id/javabridge_item_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="@dimen/space_1"
        android:background="@drawable/bg_tier_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_2"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/javabridge_item_feature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misans"
            android:textColor="@color/on_surface"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
            tools:text="Custom items / blocks" />

        <TextView
            android:id="@+id/javabridge_item_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misans"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
            tools:text="Ported as AntEgg item definitions" />
    </LinearLayout>
</LinearLayout>
