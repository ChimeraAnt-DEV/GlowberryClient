<?xml version="1.0" encoding="utf-8"?>
<!--
    The Launch-tab hero panel: a 3D player preview on the left and the selected instance's details
    plus stats on the right, on one glass MaterialCardView. The preview is the real
    CapePreviewView, so the equipped cape, hat and pet are shown exactly as they render, not as a
    generic silhouette.

    The id @id/last_played_card is kept because the activity binds the card's click (launch), the
    glow pass and the arrival animation to it.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/last_played_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/glass_panel_bg"
    app:cardCornerRadius="20dp"
    app:strokeColor="@color/glass_panel_stroke"
    app:strokeWidth="1dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Left: live 3D player preview (skin + cape + hat + pet). -->
        <org.chimeramc.client.core.mods.inbuilt.overlay.CapePreviewView
            android:id="@+id/launch_player_preview"
            android:layout_width="0dp"
            android:layout_height="196dp"
            android:layout_weight="4"
            android:contentDescription="@string/cosmetics_preview_description" />

        <!-- Right: instance identity + stats. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="6"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/last_played_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/misans"
                    android:text="@string/last_played_title"
                    android:textColor="@color/dock_text_secondary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/last_played_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="22dp"
                    android:paddingHorizontal="10dp"
                    android:gravity="center"
                    android:background="@drawable/bg_release_tag"
                    android:fontFamily="@font/misans"
                    android:text="@string/last_played_tap"
                    android:textColor="@color/on_hero_card"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/last_played_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_minecraft_cube"
                    android:padding="5dp"
                    android:background="@drawable/icon_circle_bg"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/last_played_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/misans"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/not_found_version"
                        android:textColor="@color/dock_text_primary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Title"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/last_played_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/dock_text_secondary"
                            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

                        <TextView
                            android:id="@+id/last_played_abi_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="18dp"
                            android:layout_marginStart="6dp"
                            android:paddingHorizontal="6dp"
                            android:gravity="center"
                            android:background="@drawable/bg_alpha_chip"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/primary"
                            android:textAppearance="@style/TextAppearance.Glowberry.Micro"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/last_played_instances_stat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/dock_text_primary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/misans"
                        android:text="@string/stat_instances"
                        android:textColor="@color/dock_text_secondary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@color/glass_panel_stroke" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/last_played_mods_stat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/dock_text_primary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/misans"
                        android:text="@string/stat_mods"
                        android:textColor="@color/dock_text_secondary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:background="@color/glass_panel_stroke" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/last_played_time_stat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/dock_text_primary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="@font/misans"
                        android:text="@string/stat_playtime"
                        android:textColor="@color/dock_text_secondary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
