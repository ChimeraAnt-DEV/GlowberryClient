<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_4"
    android:background="@color/overlay_panel_border">

    <TextView
        android:id="@+id/structure_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/overlay_text_muted"
        android:textAppearance="@style/TextAppearance.Glowberry.Body"
        android:layout_marginBottom="@dimen/space_3" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/structures_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="400dp" />

</LinearLayout>
