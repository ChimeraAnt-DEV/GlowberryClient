<?xml version="1.0" encoding="utf-8"?>
<!--
    VIP Controller sub-mode.

    Mirrors the launcher's Controller tab (profiles, sticks, rumble) but inside the bind-opened
    VIP screen and driven by controller input. The 3D pad on the left is live: it highlights the
    control actually being pressed, so the tabs on the right read as "this control" rather than an
    abstract name.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="@dimen/space_4">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.1"
        android:background="@drawable/bg_vip_surface"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_4">

        <TextView
            android:id="@+id/vip_controller_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:textColor="@color/ui_text_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
            android:textStyle="bold" />

        <org.chimeramc.client.launcher.ui.views.Controller3DView
            android:id="@+id/vip_controller_illustration"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_2"
            android:layout_weight="1"
            android:minHeight="150dp" />

        <TextView
            android:id="@+id/vip_controller_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:background="@drawable/bg_vip_status_off"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_2"
            android:textColor="@color/ui_text_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/space_4"
        android:layout_weight="1.4"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="@string/vip_controller_profiles"
                android:textAllCaps="true"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/vip_controller_profiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/vip_controller_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/bg_vip_surface"
                android:padding="@dimen/space_4"
                android:text="@string/vip_empty_no_controller"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:letterSpacing="0.14"
                android:text="@string/vip_dead_zone"
                android:textAllCaps="true"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/vip_controller_sliders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
