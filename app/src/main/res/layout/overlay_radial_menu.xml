<?xml version="1.0" encoding="utf-8"?>
<!--
    The radial mod wheel overlay. A single full-screen custom view draws the four-sector wheel, the
    player's skin head in the hub and the floating quick-toggle chips, and owns its own touch
    handling, so the overlay wrapper only attaches and detaches it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radial_menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    android:defaultFocusHighlightEnabled="false">

    <!-- The blurred backdrop layer (R3). Drawn behind the wheel and given one RenderEffect on
         API 31+, where it is the only correct place for the blur: a RenderEffect on the wheel
         itself would blur the wheel's own sectors and labels. GONE until a capture arrives. -->
    <ImageView
        android:id="@+id/radial_backdrop_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <org.chimeramc.client.core.mods.inbuilt.overlay.RadialMenuView
        android:id="@+id/radial_menu_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false" />

</FrameLayout>
