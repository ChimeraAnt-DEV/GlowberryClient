<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="15dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/diagnostics_title"
                android:fontFamily="@font/misans"
                android:textColor="@color/primary"
                android:textAppearance="@style/TextAppearance.Glowberry.Display"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/diagnostics_subtitle"
                android:fontFamily="@font/misans"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Body" />

            <!-- Repair installation (G2) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                style="@style/Widget.Chimera.Card.Compact"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_repair"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/diagnostics_repair_desc"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

                <Button
                    android:id="@+id/diagnostics_repair_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="44dp"
                    android:fontFamily="@font/misans"
                    android:text="@string/diagnostics_repair"
                    android:textAppearance="@style/TextAppearance.Glowberry.Label"
                    android:textAllCaps="false"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <!-- Application section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                style="@style/Widget.Chimera.Card.Compact"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_section_app"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/diagnostics_app_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Launch readiness (U14/U16): the same named state the Play button evaluates. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                style="@style/Widget.Chimera.Card.Compact"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_section_readiness"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/diagnostics_readiness_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Native libraries section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                style="@style/Widget.Chimera.Card.Compact"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_section_libs"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/diagnostics_libs_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Signature rules section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                style="@style/Widget.Chimera.Card.Compact"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_section_rules"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/diagnostics_rules_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Native render path section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                style="@style/Widget.Chimera.Card.Compact"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_section_native"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/diagnostics_native_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Account and skin sync section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                style="@style/Widget.Chimera.Card.Compact"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_section_account"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/diagnostics_account_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Mod load errors section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                style="@style/Widget.Chimera.Card.Compact"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_section_mods"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/diagnostics_mods_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/diagnostics_copy_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:minHeight="44dp"
                    android:fontFamily="@font/misans"
                    android:text="@string/diagnostics_copy"
                    android:textAppearance="@style/TextAppearance.Glowberry.Label"
                    android:textAllCaps="false"
                    android:textColor="@color/primary" />

                <Button
                    android:id="@+id/diagnostics_share_button"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:minHeight="44dp"
                    android:fontFamily="@font/misans"
                    android:text="@string/diagnostics_share"
                    android:textAppearance="@style/TextAppearance.Glowberry.Label"
                    android:textAllCaps="false"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <Button
                android:id="@+id/diagnostics_refresh_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="44dp"
                android:fontFamily="@font/misans"
                android:text="@string/diagnostics_refresh"
                android:textAppearance="@style/TextAppearance.Glowberry.Label"
                android:textAllCaps="false"
                android:textColor="@color/primary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>