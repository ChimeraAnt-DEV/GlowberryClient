<?xml version="1.0" encoding="utf-8"?>
<!--
    VIP Keyboard sub-mode.

    The drawn keyboard on the left highlights the selected control; the right column lists the
    actions that can be rebound and the pointer settings, so the whole key/mouse surface is
    customisable without leaving the tab.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="@dimen/space_4">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:background="@drawable/bg_vip_surface"
        android:orientation="vertical"
        android:padding="@dimen/space_4">

        <TextView
            android:id="@+id/vip_keyboard_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/vip_live_preview"
            android:textAllCaps="true"
            android:textColor="@color/ui_text_secondary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
            android:textStyle="bold" />

        <org.chimeramc.client.launcher.ui.views.KeyboardIllustrationView
            android:id="@+id/vip_keyboard_illustration"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_3"
            android:layout_weight="1"
            android:minHeight="140dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/space_4"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="@string/vip_section_remap"
                android:textAllCaps="true"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/vip_keyboard_keys"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="vertical" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:letterSpacing="0.14"
                android:text="@string/vip_sensitivity"
                android:textAllCaps="true"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/vip_keyboard_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:background="@drawable/bg_vip_surface"
                android:padding="@dimen/space_4"
                android:text="@string/vip_keyboard_hint"
                android:textColor="@color/ui_text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
