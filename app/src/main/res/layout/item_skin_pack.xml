<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_1"
    style="@style/Widget.Chimera.Card"
    android:orientation="vertical"
    android:padding="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_circle"
            android:alpha="0.18"
            android:gravity="center">

            <ImageView
                android:id="@+id/skin_preview"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_tshirt"
                app:tint="@color/text_secondary"
                android:contentDescription="@string/skins_title" />

            <ProgressBar
                android:id="@+id/skin_preview_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_3"
            android:orientation="vertical">

            <TextView
                android:id="@+id/skin_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misans"
                android:textColor="@color/on_surface"
                android:textAppearance="@style/TextAppearance.Glowberry.Title"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/skin_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_hairline"
                android:fontFamily="@font/misans"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/skin_applied"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:fontFamily="@font/misans"
                android:textColor="@color/primary"
                android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/skin_apply_button"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:minWidth="0dp"
            android:minHeight="34dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="@dimen/space_4"
            android:paddingVertical="0dp"
            android:fontFamily="@font/misans"
            android:backgroundTint="@color/primary"
            android:text="@string/skins_apply"
            android:textColor="@color/on_primary"
            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
            android:textStyle="bold"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>