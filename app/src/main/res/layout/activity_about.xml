<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_6"
            android:paddingEnd="@dimen/space_6"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_6">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_page_title"
                android:fontFamily="@font/misans"
                android:textColor="@color/primary"
                android:textAppearance="@style/TextAppearance.Glowberry.Display"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/about_subtitle"
                android:fontFamily="@font/misans"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.Glowberry.Body" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                style="@style/Widget.Chimera.Card.Compact"
                android:orientation="vertical"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_authors_title"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_surface"
                    android:textAppearance="@style/TextAppearance.Glowberry.Title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.microsoft.xbox.idp.toolkit.CircleImageView
                        android:id="@+id/author_avatar"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_qa_account"
                        android:scaleType="centerCrop" 
                        android:importantForAccessibility="no"
                        />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/about_author_name"
                                android:fontFamily="@font/misans"
                                android:textColor="@color/on_surface"
                                android:textAppearance="@style/TextAppearance.Glowberry.Title"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/author_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="18dp"
                                android:layout_marginStart="@dimen/space_2"
                                android:paddingHorizontal="@dimen/space_2"
                                android:gravity="center"
                                android:text="@string/about_author_badge"
                                android:fontFamily="@font/misans"
                                android:textColor="@color/on_primary"
                                android:textAppearance="@style/TextAppearance.Glowberry.Micro"
                                android:textStyle="bold"
                                android:background="@drawable/bg_author_badge" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_hairline"
                            android:text="@string/about_author_role"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_patreon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="28dp"
                        android:paddingHorizontal="@dimen/space_4"
                        android:gravity="center"
                        android:text="@string/about_patreon"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/status_warning"
                        android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                        android:textStyle="bold"
                        android:background="@drawable/bg_link_chip_orange"
                        android:drawableStart="@drawable/ic_patreon"
                        android:drawablePadding="@dimen/space_2"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btn_afdian"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="28dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:paddingHorizontal="@dimen/space_4"
                        android:gravity="center"
                        android:text="@string/about_afdian"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/status_accent_pink"
                        android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                        android:textStyle="bold"
                        android:background="@drawable/bg_link_chip_pink"
                        android:drawableStart="@drawable/ic_afdian"
                        android:drawablePadding="@dimen/space_2"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/space_4"
                    android:layout_marginBottom="@dimen/space_hairline"
                    android:background="@color/wash_black_10" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.microsoft.xbox.idp.toolkit.CircleImageView
                        android:id="@+id/maintainer_avatar"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_qa_account"
                        android:scaleType="centerCrop" 
                        android:importantForAccessibility="no"
                        />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/about_maintainer_name"
                                android:fontFamily="@font/misans"
                                android:textColor="@color/on_surface"
                                android:textAppearance="@style/TextAppearance.Glowberry.Title"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/maintainer_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="18dp"
                                android:layout_marginStart="@dimen/space_2"
                                android:paddingHorizontal="@dimen/space_2"
                                android:gravity="center"
                                android:text="@string/maintainer"
                                android:fontFamily="@font/misans"
                                android:textColor="@color/on_primary"
                                android:textAppearance="@style/TextAppearance.Glowberry.Micro"
                                android:textStyle="bold"
                                android:background="@drawable/bg_author_badge" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_hairline"
                            android:text="@string/maintainer"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_youtube_maintainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="28dp"
                        android:paddingHorizontal="@dimen/space_4"
                        android:gravity="center"
                        android:text="@string/youtube"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/error"
                        android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                        android:textStyle="bold"
                        android:background="@drawable/bg_link_chip_pink"
                        android:drawableStart="@drawable/ic_youtube"
                        android:drawablePadding="@dimen/space_2"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_2"
                    style="@style/Widget.Chimera.Card.Compact"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_source_title"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.Glowberry.Title"
                        android:textStyle="bold"
                        android:drawableStart="@drawable/ic_code"
                        android:drawablePadding="@dimen/space_2" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_github_repo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="28dp"
                            android:paddingHorizontal="@dimen/space_4"
                            android:gravity="center"
                            android:text="@string/about_github_repo"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/on_surface"
                            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                            android:background="@drawable/bg_link_chip_blue"
                            android:drawableStart="@drawable/ic_github"
                            android:drawablePadding="@dimen/space_2"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btn_github_org"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="28dp"
                            android:layout_marginStart="@dimen/space_2"
                            android:paddingHorizontal="@dimen/space_4"
                            android:gravity="center"
                            android:text="@string/about_github_org"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/on_surface"
                            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                            android:background="@drawable/bg_link_chip_blue"
                            android:drawableStart="@drawable/ic_github"
                            android:drawablePadding="@dimen/space_2"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:text="@string/about_license_note"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_2"
                    style="@style/Widget.Chimera.Card.Compact"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_contribute_title"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textAppearance="@style/TextAppearance.Glowberry.Title"
                        android:textStyle="bold"
                        android:drawableStart="@drawable/ic_github"
                        android:drawablePadding="@dimen/space_2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/about_contribute_desc"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.Glowberry.Caption" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_issues"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="28dp"
                            android:paddingHorizontal="@dimen/space_4"
                            android:gravity="center"
                            android:text="@string/about_issues"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/on_surface"
                            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                            android:background="@drawable/bg_link_chip_blue"
                            android:drawableStart="@drawable/ic_github"
                            android:drawablePadding="@dimen/space_2"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/btn_star_fork"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="28dp"
                            android:layout_marginStart="@dimen/space_2"
                            android:paddingHorizontal="@dimen/space_4"
                            android:gravity="center"
                            android:text="@string/about_star_fork"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/primary"
                            android:textAppearance="@style/TextAppearance.Glowberry.Caption"
                            android:textStyle="bold"
                            android:background="@drawable/bg_link_chip_green"
                            android:drawableStart="@drawable/ic_star"
                            android:drawablePadding="@dimen/space_2"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
